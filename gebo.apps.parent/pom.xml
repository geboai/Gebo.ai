<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo</groupId>
		<artifactId>ai.gebo.parent</artifactId>
		<version>1.0.3.0-SNAPSHOT</version>
	</parent>
	<groupId>ai.gebo.apps</groupId>
	<artifactId>gebo.apps.parent</artifactId>
	
	<packaging>pom</packaging>
	<modules>
		<module>gebo.ai.app</module>

		<module>gebo.apps.monolithic.starter</module>

		<!-- The microservices apps are intentionally NOT part of the default
		     gebo.apps.parent reactor: they are built on demand with an explicit
		     command, e.g.
		         mvn -f gebo.apps.parent/gebo.microservices.apps.parent/pom.xml -P docker clean package jib:buildTar
		     (see MICROSERVICES-STUBS-ARCHITECTURE.md). Re-enable the module to
		     build them as part of the monolithic build. -->
		<!-- <module>gebo.microservices.apps.parent</module> -->
	</modules>

	<!--
	  OWASP dependency-check lives here, in one place, for every deployable app:
	  gebo.ai.app and - through gebo.microservices.apps.parent - the 21 microservice
	  apps. This is their only common ancestor.

	  The scanner is NEVER bound by default. Exactly one of the two profiles below
	  turns it on:

	      mvn -Pverify-security verify        report only, never blocks
	      mvn -Pproduction-security verify    blocks on CRITICAL, and on scanner failure

	  They are mutually exclusive and the build enforces it (see the enforcer rule).
	-->
	<properties>
		<dependency-check.version>12.2.2</dependency-check.version>

		<!-- build ordinaria: non bloccare. 11 is above the CVSS maximum of 10, so
		     the threshold is deliberately unreachable and the scan only reports.
		     The 'production-security' profile lowers it. -->
		<dependency-check.failBuildOnCVSS>11</dependency-check.failBuildOnCVSS>
		<dependency-check.failOnError>false</dependency-check.failOnError>

		<!-- Marker flipped to true by the 'production-security' profile and read back by the
		     enforcer rule that the 'verify-security' profile installs. That indirection is
		     what makes the two profiles mutually exclusive: Maven has no native way
		     to forbid a profile combination, but a property set by one profile is
		     visible to a rule contributed by the other. -->
		<gebo.owasp.production>false</gebo.owasp.production>
	</properties>

	<build>
		<pluginManagement>
			<plugins>
				<!-- Configuration only. pluginManagement is inherited by every app
				     module but binds nothing on its own: the plugin actually runs only
				     where the 'verify-security' / 'production-security' profiles below declare it. -->
				<plugin>
					<groupId>org.owasp</groupId>
					<artifactId>dependency-check-maven</artifactId>
					<version>${dependency-check.version}</version>
					<executions>
						<execution>
							<id>dependency-vulnerability-check</id>
							<phase>verify</phase>
							<goals>
								<goal>aggregate</goal>
							</goals>
						</execution>
					</executions>
					<configuration>
						<autoUpdate>true</autoUpdate>
						<failBuildOnCVSS>${dependency-check.failBuildOnCVSS}</failBuildOnCVSS>
						<failOnError>${dependency-check.failOnError}</failOnError>
						<formats>
							<format>HTML</format>
							<format>JSON</format>
						</formats>
						<outputDirectory>${project.build.directory}/dependency-check</outputDirectory>
					</configuration>
				</plugin>

				<!-- Guards the mutual exclusion of 'verify-security' and 'production-security'. Declared -
				     and therefore run - only by the 'verify-security' profile. The version comes
				     from spring-boot-starter-parent's pluginManagement. -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-enforcer-plugin</artifactId>
					<executions>
						<execution>
							<id>owasp-profiles-mutually-exclusive</id>
							<phase>validate</phase>
							<goals>
								<goal>enforce</goal>
							</goals>
							<configuration>
								<rules>
									<requireProperty>
										<property>gebo.owasp.production</property>
										<regex>^false$</regex>
										<regexMessage>Profiles 'verify-security' and 'production-security' are mutually exclusive and cannot be activated together. 'verify-security' runs OWASP dependency-check as a report (failBuildOnCVSS=11, failOnError=false); 'production-security' runs the same scan as a gate (failBuildOnCVSS=9.0, failOnError=true). Activate exactly one: mvn -Pverify-security verify, or mvn -Pproduction-security verify.</regexMessage>
									</requireProperty>
								</rules>
							</configuration>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<profiles>
		<!--
		  Informational scan. NOT active by default; activate with

		      mvn -Pverify-security verify

		  Thresholds are the inherited defaults, so the scan writes
		  target/dependency-check/{html,json} and never fails the build - a scanner
		  error is tolerated too. Mutually exclusive with 'production-security'.
		-->
		<profile>
			<id>verify-security</id>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<build>
				<plugins>
					<!-- Refuses to run alongside -Pproduction-security; fails at validate, before
					     any of the expensive work. -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-enforcer-plugin</artifactId>
					</plugin>
					<plugin>
						<groupId>org.owasp</groupId>
						<artifactId>dependency-check-maven</artifactId>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!--
		  The same scan as a release gate. NOT active by default; activate with

		      mvn -Pproduction-security verify

		  Fails the build on any CRITICAL (CVSS >= 9.0) and - se lo scanner non
		  funziona, produzione bloccata - on a scanner error as well. Mutually
		  exclusive with 'verify-security'.
		-->
		<profile>
			<id>production-security</id>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<properties>
				<gebo.owasp.production>true</gebo.owasp.production>
				<!-- Critical -->
				<dependency-check.failBuildOnCVSS>9.0</dependency-check.failBuildOnCVSS>
				<!-- se lo scanner non funziona, produzione bloccata -->
				<dependency-check.failOnError>true</dependency-check.failOnError>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.owasp</groupId>
						<artifactId>dependency-check-maven</artifactId>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
