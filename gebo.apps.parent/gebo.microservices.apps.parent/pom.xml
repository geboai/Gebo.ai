<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.apps</groupId>
		<artifactId>gebo.apps.parent</artifactId>
		<version>1.0.2.0-SNAPSHOT</version>
	</parent>
	<groupId>ai.gebo.apps.microservices</groupId>
	<artifactId>gebo.microservices.apps.parent</artifactId>
	<packaging>pom</packaging>

	<properties>
		<spring-cloud.version>2025.1.2</spring-cloud.version>
	</properties>

	<modules>
		<module>eureka.gebo.ai</module>
		<module>gateway.gebo.ai</module>
		<module>brain.gebo.ai</module>
		<module>vectorizator.gebo.ai</module>
		<module>graphicator.gebo.ai</module>
		<module>chunker.gebo.ai</module>
		<!-- Content-handler microservices (one per gebo.systems.parent handler). -->
		<module>git.gebo.ai</module>
		<module>filesystem.gebo.ai</module>
		<module>uploads.gebo.ai</module>
		<module>userspace.gebo.ai</module>
		<module>sharepoint.gebo.ai</module>
		<module>confluence.gebo.ai</module>
		<module>jira.gebo.ai</module>
		<module>googledrive.gebo.ai</module>
		<module>mcpclient.gebo.ai</module>
		<module>integration.gebo.ai</module>
	</modules>

	<!--
	  Every Gebo microservice app (gateway + backends) is a Spring Cloud discovery
	  client: it registers with the Eureka server (eureka.gebo.ai) under its
	  application name - the canonical underscore microservice id (e.g. brain_gebo_ai)
	  - so client-side load balancing (@LoadBalanced RestTemplate/WebClient, Feign)
	  and the gateway's lb:// routes resolve to live instances. The eureka.gebo.ai
	  server module brings the Eureka server starter (which supersedes this client)
	  and runs standalone.
	-->
	<dependencies>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>
	</dependencies>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
