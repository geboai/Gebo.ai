<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.apps.microservices</groupId>
		<artifactId>gebo.microservices.apps.parent</artifactId>
		<version>1.0.2.2</version>
	</parent>
	<artifactId>brain.gebo.ai</artifactId>

	<dependencies>
		<!-- The Spring Security filter chain + LOCAL_JWT provider (GeboAISecurityConfig,
		     LocalJwtTokenProvider, GSecurityServiceImpl, AclGrantedAccessorServiceImpl).
		     Deliberately WITHOUT gebo.security.directory.mongo: the
		     gebo.microservices.security.client already on this classpath (transitively,
		     via gebo.microservices.llms.starter) supplies the IGSecurityDirectory bean
		     via a REST call to heimdall instead, so no local Mongo-backed user store is
		     created here - only the filter chain that validates tokens heimdall issued. -->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.security</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- Full LLMs microservice stack: LLM abstraction layer, microservices
		     environment, RabbitMQ bridge, models-replication cache and shared
		     topology. -->
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.llms.starter</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- The concrete, mapped admin controllers split out of
		     gebo.architecture.llms.abstraction.layer (ChatModelsController,
		     EmbeddingModelsControllers, ImageModelsController,
		     RankerModelsController, TextToSpeechModelsController,
		     TranscriptModelsController, ChatModelsLookupController,
		     FunctionsLookupController). Deliberately NOT bundled into
		     gebo.microservices.llms.starter: brain owns LLM configuration
		     admin, vectorizator/graphicator (the starter's other consumers)
		     do not need it on their classpath. -->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.llms.abstraction.layer.controllers</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- Every LLM provider driver's admin controllers
		     (OpenAIChatModelsConfigurationController, ...). Note this also pulls
		     in each provider's actual driver implementation transitively (a
		     provider's controller extends its Base*Controller parameterized with
		     that provider's own model/service types, so the two cannot be
		     separated) - previously NO microservice carried the provider drivers
		     at all (only the monolith, via gebo.llms.starter); this is what
		     makes brain the first one to. -->
		<dependency>
			<groupId>ai.gebo.llms</groupId>
			<artifactId>gebo.llms.controllers.starter</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- LLM fast-setup owner: brain hosts the setup controller/service and the
		     config-driven bootstrap; created models propagate to the other LLM
		     microservices via the shared Mongo + Hazelcast models-replication cache. -->
		<dependency>
			<groupId>ai.gebo.llms</groupId>
			<artifactId>gebo.llms.setup</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.chat.abstraction.layer</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.agents.abstraction.layer</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.agents.standard</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.ragsystem</groupId>
			<artifactId>gebo.ragsystem.client.rest</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.fastsetup.rag</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- Knowledge-base + project CRUD (KnowledgeBaseController,
		     ProjectsController, UserKnowledgeBaseBrowsingController, ...).
		     These admin controllers live in gebo.core and were monolith-only
		     until now: brain is the LLM/RAG admin microservice, so it is the
		     natural home for KB/project creation in the microservices cluster.
		     Without this, the cluster has no REST surface to create a
		     knowledge base or a project - the microservices setup-and-use
		     integration test needs both before it can publish a filesystem
		     endpoint and run a chat pipeline. -->
		<dependency>
			<groupId>ai.gebo.core</groupId>
			<artifactId>gebo.core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- brain OWNS the GProject/GKnowledgeBase store (gebo.core, above, brings
		     GeboIngestionManager and friends onto this classpath transitively via
		     gebo.architecture.contentsystems.abstraction.layer), so it needs the
		     LOCAL, Mongo-backed IGKnowledgeBaseHierarchyLookupService, not the REST
		     client every other content-handler microservice takes - it would be
		     asking itself over the network for data it already has. -->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.knowledgebase.hierarchy.local</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- Topology-aware REST clients for the per-connector search services
		     (jira/confluence/sharepoint/googledrive), so brain's deep-search reaches
		     them on their own microservices. -->
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.searchservices.clients</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- Web-search tools that run in-process on brain (not real content handlers,
		     so added here directly rather than via a content microservice). -->
		<dependency>
			<groupId>ai.gebo.systems</groupId>
			<artifactId>gebo.bingsearch.handler</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.systems</groupId>
			<artifactId>gebo.googlesearch.handler</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- MCP integration: brain acts as MCP client (to call external MCP
		     servers as tools during chat/agent sessions) and as MCP server
		     (to expose gebo's own knowledge base/tools over MCP to external
		     clients). -->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.mcp-clients</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.mcp-server</artifactId>
			<version>${project.version}</version>
		</dependency>
	</dependencies>

	<profiles>
		<!-- Bootable fat jar WITH the OpenAPI/Swagger UI (classifier
		bootable+swagger). -->
		<profile>
			<id>swagger-on</id>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<configuration>
							<jvmArguments>
								--add-opens=java.base/java.nio.charset=ALL-UNNAMED</jvmArguments>
							<mainClass>
								ai.gebo.microservices.brain.BrainApplication</mainClass>
							<excludeDevtools>false</excludeDevtools>
							<layout>JAR</layout>
							<classifier>bootable+swagger</classifier>
						</configuration>
					</plugin>
				</plugins>
			</build>
			<dependencies>
				<dependency>
					<groupId>ai.gebo.architecture</groupId>
					<artifactId>gebo.architecture.swagger</artifactId>
					<version>${project.version}</version>
				</dependency>
			</dependencies>
		</profile>
		<!-- Bootable fat jar (classifier bootable). -->
		<profile>
			<id>bootables</id>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<configuration>
							<mainClass>
								ai.gebo.microservices.brain.BrainApplication</mainClass>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-jar-plugin</artifactId>
						<configuration>
							<archive>
								<manifest>
									<mainClass>
										ai.gebo.microservices.brain.BrainApplication</mainClass>
								</manifest>
							</archive>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<configuration>
							<jvmArguments>
								--add-opens=java.base/java.nio.charset=ALL-UNNAMED</jvmArguments>
							<mainClass>
								ai.gebo.microservices.brain.BrainApplication</mainClass>
							<excludeDevtools>false</excludeDevtools>
							<layout>JAR</layout>
							<classifier>bootable</classifier>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
