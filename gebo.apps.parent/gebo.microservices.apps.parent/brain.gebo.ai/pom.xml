<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.apps.microservices</groupId>
		<artifactId>gebo.microservices.apps.parent</artifactId>
		<version>1.0.4.0-SNAPSHOT</version>
	</parent>
	<artifactId>brain.gebo.ai</artifactId>

	<dependencies>
		<!--
		  UI text resources / i18n. UITextResourcesController (/public/UITextResourcesController)
		  serves the translated UI text bundles the Angular field-translation container reads,
		  and LanguageResourcesController the language catalogue. Hosted on brain: it is the
		  aggregate the UI already talks to, and the surface is unauthenticated static content.
		-->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.multilanguage.support</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!--
		  Entity-editor form metadata. GeboAngularFormGroupMetaInfoController
		  (api/admin/AngularFormGroupController) reflects over the repositories on THIS
		  service's classpath and reports, per managed entity, the properties an Angular
		  editor's FormGroup may be missing - the UI then adds the missing controls so a
		  persisted property is never silently dropped on save. The catalogue is
		  per-JVM, so every service that manages entities has to publish its own;
		  the monolith publishes them all from one classpath.
		-->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.angular.persistence.support</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- The Spring Security filter chain + LOCAL_JWT provider (GeboAISecurityConfig,
		     LocalJwtTokenProvider, GSecurityServiceImpl, AclGrantedAccessorServiceImpl).
		     Deliberately WITHOUT gebo.security.directory.mongo: the
		     gebo.microservices.security.client already on this classpath (transitively,
		     via gebo.microservices.llms.starter) supplies the IGSecurityDirectory bean
		     via a REST call to heimdall instead, so no local Mongo-backed user store is
		     created here - only the filter chain that validates tokens heimdall issued. -->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.security</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- Full LLMs microservice stack: LLM abstraction layer, microservices
		     environment, RabbitMQ bridge, models-replication cache and shared
		     topology. -->
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.llms.starter</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- The concrete, mapped admin controllers split out of
		     gebo.architecture.llms.abstraction.layer (ChatModelsController,
		     EmbeddingModelsControllers, ImageModelsController,
		     RankerModelsController, TextToSpeechModelsController,
		     TranscriptModelsController, ChatModelsLookupController,
		     FunctionsLookupController). Deliberately NOT bundled into
		     gebo.microservices.llms.starter: brain owns LLM configuration
		     admin, vectorizator/graphicator (the starter's other consumers)
		     do not need it on their classpath. -->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.llms.abstraction.layer.controllers</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- Every LLM provider driver's admin controllers
		     (OpenAIChatModelsConfigurationController, ...). Note this also pulls
		     in each provider's actual driver implementation transitively (a
		     provider's controller extends its Base*Controller parameterized with
		     that provider's own model/service types, so the two cannot be
		     separated) - previously NO microservice carried the provider drivers
		     at all (only the monolith, via gebo.llms.starter); this is what
		     makes brain the first one to. -->
		<dependency>
			<groupId>ai.gebo.llms</groupId>
			<artifactId>gebo.llms.controllers.starter</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.neo4j.controllers</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- LLM fast-setup owner: brain hosts the setup controller/service and the
		     config-driven bootstrap; created models propagate to the other LLM
		     microservices via the shared Mongo + Hazelcast models-replication cache. -->
		<dependency>
			<groupId>ai.gebo.llms</groupId>
			<artifactId>gebo.llms.setup</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.chat.abstraction.layer</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.agents.abstraction.layer</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.agents.standard</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.ragsystem</groupId>
			<artifactId>gebo.ragsystem.client.rest</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.fastsetup.rag</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- Knowledge-base + project CRUD (KnowledgeBaseController,
		     ProjectsController, UserKnowledgeBaseBrowsingController, ...).
		     These admin controllers live in gebo.core and were monolith-only
		     until now: brain is the LLM/RAG admin microservice, so it is the
		     natural home for KB/project creation in the microservices cluster.
		     Without this, the cluster has no REST surface to create a
		     knowledge base or a project - the microservices setup-and-use
		     integration test needs both before it can publish a filesystem
		     endpoint and run a chat pipeline. -->
		<dependency>
			<groupId>ai.gebo.core</groupId>
			<artifactId>gebo.core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- brain OWNS the GProject/GKnowledgeBase store (gebo.core, above, brings
		     GeboIngestionManager and friends onto this classpath transitively via
		     gebo.architecture.contentsystems.abstraction.layer), so it needs the
		     LOCAL, Mongo-backed IGKnowledgeBaseHierarchyLookupService, not the REST
		     client every other content-handler microservice takes - it would be
		     asking itself over the network for data it already has. -->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.knowledgebase.hierarchy.local</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- Topology-aware REST clients for the per-connector search services
		     (jira/confluence/sharepoint/googledrive), so brain's deep-search reaches
		     them on their own microservices. -->
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.searchservices.clients</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- Web-search tools that run in-process on brain (not real content handlers,
		     so added here directly rather than via a content microservice). -->
		<dependency>
			<groupId>ai.gebo.systems</groupId>
			<artifactId>gebo.googlesearch.handler</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.systems</groupId>
			<artifactId>gebo.tavilysearch.handler</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.systems</groupId>
			<artifactId>gebo.bravesearch.handler</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.systems</groupId>
			<artifactId>gebo.searxngsearch.handler</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.systems</groupId>
			<artifactId>gebo.serpapisearch.handler</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- MCP integration: brain acts as MCP client (to call external MCP
		     servers as tools during chat/agent sessions) and as MCP server
		     (to expose gebo's own knowledge base/tools over MCP to external
		     clients). -->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.mcp-clients</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- McpClientConfigController lives here, not in the base mcp-clients
		     module, so the config admin endpoint is served by brain but NOT by the
		     mcpclient content-handler microservice (which shares the same Mongo and
		     still reads the configs through the base module). -->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.mcp-clients.controllers</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo</groupId>
			<artifactId>gebo.system.ingestion.controllers</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.mcp-server</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- Agent2Agent (A2A) protocol: integrate external A2A agents (a2a-clients)
		     and export gebo agents/networks over A2A (a2a-server). -->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.a2a-clients</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.a2a-server</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- OpenSearch: the SHARED full-text store, written by fulltextor and READ
		     here. brain already carried gebo.architecture.fulltext (the abstraction)
		     but not this implementation, and that silently disabled its lexical leg:
		     FullTextSearchDocumentsCachedDaoImpl is @ConditionalOnBean(IGFullTextSearchService),
		     so with no implementation the DAO was never registered, GeboRagSearchConfig
		     took the null its @Autowired(required=false) allows, and
		     GDocumentsSearchServiceImpl's `lexicalLegAvailable = fullTextSearch != null`
		     was ALWAYS false - hybrid retrieval quietly degraded to semantic-only even
		     though the shared config overlay sets ai.gebo.opensearch.enabled=true for
		     the whole cluster.

		     Same shape as the other two shared stores: brain holds a CLIENT for the
		     store its companion service fills (neo4j <- graphicator, qdrant <-
		     vectorizator, opensearch <- fulltextor) and reads the same index
		     (kb_chunks) from the same host, resolved from the same shared overlay.

		     Deliberately NOT gebo.ragsystem.content.fulltext.processor, which is what
		     fulltextor depends on: that module carries FullTextIndexingBatchMessageReceiver,
		     the INGESTION driver. brain reads the index, it must not become a second
		     writer to it.

		     Inert unless switched on: every bean in this module is
		     @ConditionalOnProperty(ai.gebo.opensearch.enabled) and OpenSearchConfig
		     defaults it to false, so full-text search stays cleanly disable-able and a
		     standalone brain is unaffected. -->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.opensearch</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- BrainFullTopologyContextTest boots brain in its FULL configuration, which
		     means a live Neo4j: with ai.gebo.neo4j.enabled=true (brain's shipped
		     default) Neo4jDdlRunner executes the graph DDL as an ApplicationRunner
		     during startup, so the context cannot load without one. The Mongo/JUnit
		     testcontainers deps are inherited from gebo.microservices.apps.parent;
		     this module is the only microservice besides graphicator that also needs
		     the graph store, so it is declared here rather than in that parent. -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-neo4j</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.opensearch</groupId>
			<artifactId>opensearch-testcontainers</artifactId>
			<version>4.1.0</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<profiles>
		<!-- Bootable fat jar WITH the OpenAPI/Swagger UI (classifier
		bootable+swagger). -->
		<profile>
			<id>swagger-on</id>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<configuration>
							<jvmArguments>
								--add-opens=java.base/java.nio.charset=ALL-UNNAMED</jvmArguments>
							<mainClass>
								ai.gebo.microservices.brain.BrainApplication</mainClass>
							<excludeDevtools>false</excludeDevtools>
							<layout>JAR</layout>
							<classifier>bootable+swagger</classifier>
						</configuration>
					</plugin>
				</plugins>
			</build>
			<dependencies>
				<dependency>
					<groupId>ai.gebo.architecture</groupId>
					<artifactId>gebo.architecture.swagger</artifactId>
					<version>${project.version}</version>
				</dependency>
			</dependencies>
		</profile>
		<!-- Bootable fat jar (classifier bootable). -->
		<profile>
			<id>bootables</id>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<configuration>
							<mainClass>
								ai.gebo.microservices.brain.BrainApplication</mainClass>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-jar-plugin</artifactId>
						<configuration>
							<archive>
								<manifest>
									<mainClass>
										ai.gebo.microservices.brain.BrainApplication</mainClass>
								</manifest>
							</archive>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<configuration>
							<jvmArguments>
								--add-opens=java.base/java.nio.charset=ALL-UNNAMED</jvmArguments>
							<mainClass>
								ai.gebo.microservices.brain.BrainApplication</mainClass>
							<excludeDevtools>false</excludeDevtools>
							<layout>JAR</layout>
							<classifier>bootable</classifier>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
