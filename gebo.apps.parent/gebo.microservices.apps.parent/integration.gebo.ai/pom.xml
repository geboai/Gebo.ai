<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.apps.microservices</groupId>
		<artifactId>gebo.microservices.apps.parent</artifactId>
		<version>1.0.2.3-SNAPSHOT</version>
	</parent>
	<artifactId>integration.gebo.ai</artifactId>

	<!--
	  Integration content-handler microservice. The gebo.microservices.starter
	  provides the microservices environment, RabbitMQ bridge, shared topology and
	  (inherited) Eureka discovery client; gebo.integration.content.handler is the
	  hosted content system.
	-->
	<dependencies>
		<!-- Does not own the ACL store either: IAclAliasesDao is a locally-cached REST
		     client onto heimdall. -->
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.acl.client</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- This service does not own the GProject/GKnowledgeBase store either:
		     IGKnowledgeBaseHierarchyLookupService is a REST client onto brain. -->
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.knowledgebase.client</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- This service does not host the secrets either: IGeboSecretsAccessService is
		     a REST client onto heimdall. (Not inheritable from gebo.microservices.starter
		     - heimdall is built on that too, and it owns the real implementation.) -->
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.secrets.client</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- This service does NOT own the user store: its IGSecurityDirectory is a REST
		     client onto heimdall. The authorization services themselves stay local - only
		     the directory (users, groups, password checks) is remote. -->
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.security.client</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.starter</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.systems</groupId>
			<artifactId>gebo.integration.content.handler</artifactId>
			<version>${project.version}</version>
		</dependency>
	</dependencies>

	<profiles>
		<!-- Bootable fat jar (classifier bootable). -->
		<!-- Bootable fat jar WITH the OpenAPI/Swagger UI (classifier
		bootable+swagger). Off by default: production ships no API console. It is
		also what lets this service publish /v3/api-docs, which is where its
		generated client stubs (gebo.microservices.clients.parent) read the spec
		from. -->
		<profile>
			<id>swagger-on</id>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<configuration>
							<jvmArguments>
								--add-opens=java.base/java.nio.charset=ALL-UNNAMED</jvmArguments>
							<mainClass>ai.gebo.microservices.integration.IntegrationApplication</mainClass>
							<excludeDevtools>false</excludeDevtools>
							<layout>JAR</layout>
							<classifier>bootable+swagger</classifier>
						</configuration>
					</plugin>
				</plugins>
			</build>
			<dependencies>
				<dependency>
					<groupId>ai.gebo.architecture</groupId>
					<artifactId>gebo.architecture.swagger</artifactId>
					<version>${project.version}</version>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>bootables</id>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<configuration>
							<mainClass>ai.gebo.microservices.integration.IntegrationApplication</mainClass>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-jar-plugin</artifactId>
						<configuration>
							<archive>
								<manifest>
									<mainClass>ai.gebo.microservices.integration.IntegrationApplication</mainClass>
								</manifest>
							</archive>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<configuration>
							<jvmArguments>
								--add-opens=java.base/java.nio.charset=ALL-UNNAMED</jvmArguments>
							<mainClass>ai.gebo.microservices.integration.IntegrationApplication</mainClass>
							<excludeDevtools>false</excludeDevtools>
							<layout>JAR</layout>
							<classifier>bootable</classifier>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
