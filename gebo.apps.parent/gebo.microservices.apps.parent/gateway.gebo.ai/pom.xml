<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.apps.microservices</groupId>
		<artifactId>gebo.microservices.apps.parent</artifactId>
		<version>1.0.2.0-SNAPSHOT</version>
	</parent>
	<artifactId>gateway.gebo.ai</artifactId>

	<dependencies>
		<!-- Spring Cloud Gateway (reactive / WebFlux server) -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
		</dependency>
		<!-- Spring Cloud LoadBalancer -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-loadbalancer</artifactId>
		</dependency>
	</dependencies>

	<profiles>
		<profile>
			<id>bootables</id>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>

						<configuration>
							<mainClass>ai.gebo.microservices.gateway.GatewayApplication</mainClass>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-jar-plugin</artifactId>
						<configuration>
							<archive>
								<manifest>
									<mainClass>ai.gebo.microservices.gateway.GatewayApplication</mainClass>
								</manifest>
							</archive>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>

						<configuration>
							<jvmArguments>
								--add-opens=java.base/java.nio.charset=ALL-UNNAMED</jvmArguments>
							<mainClass>ai.gebo.microservices.gateway.GatewayApplication</mainClass>
							<excludeDevtools>false</excludeDevtools>
							<layout>JAR</layout>

							<classifier>bootable</classifier>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>package-unix-deb</id>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<configuration>
							<mainClass>ai.gebo.microservices.gateway.GatewayApplication</mainClass>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-jar-plugin</artifactId>
						<configuration>
							<archive>
								<manifest>
									<mainClass>ai.gebo.microservices.gateway.GatewayApplication</mainClass>
								</manifest>
							</archive>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<configuration>
							<jvmArguments>
								--add-opens=java.base/java.nio.charset=ALL-UNNAMED</jvmArguments>
							<mainClass>ai.gebo.microservices.gateway.GatewayApplication</mainClass>
							<excludeDevtools>false</excludeDevtools>
							<layout>JAR</layout>
							<classifier>bootable</classifier>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-resources-plugin</artifactId>
						<executions>
							<execution>
								<id>copy-jar</id>
								<phase>package</phase>
								<goals>
									<goal>copy-resources</goal>
								</goals>
								<configuration>
									<outputDirectory>${project.build.directory}/jpackage/lib</outputDirectory>
									<resources>
										<resource>
											<directory>${project.build.directory}</directory>
											<includes>
												<include>${project.build.finalName}-bootable.jar</include>
											</includes>
										</resource>
									</resources>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.panteleyev</groupId>
						<artifactId>jpackage-maven-plugin</artifactId>
						<version>1.7.1</version>
						<executions>
							<execution>
								<id>gebo-ai-gateway-deb</id>
								<phase>package</phase>
								<goals>
									<goal>jpackage</goal>
								</goals>
								<configuration>
									<destination>${project.build.directory}/installer</destination>
									<input>${project.build.directory}/jpackage/lib</input>
									<mainJar>${project.build.finalName}-bootable.jar</mainJar>
									<name>gebo-ai-gateway</name>
									<linuxPackageName>gebo-ai-gateway</linuxPackageName>
									<type>DEB</type>
									<installDir>/home/gebo-ai-gateway</installDir>
									<linuxDebMaintainer>paolo.zavalloni@gebo.ai</linuxDebMaintainer>
									<linuxAppCategory>utils</linuxAppCategory>
									<launcherAsService>true</launcherAsService>
									<resourceDir>${project.basedir}/src/packaging/deb/resources</resourceDir>
									<appContentPaths>
										<path>${project.basedir}/src/packaging/deb/gebo-ai-gateway.service</path>
									</appContentPaths>
									<verbose>true</verbose>
									<javaOptions>
										<option>-Djava.net.preferIPv4Stack=true</option>
										<option>-Dspring.config.additional-location=file:/etc/gebo-ai-gateway/</option>
										<option>-Dsun.jnu.encoding=UTF-8</option>
										<option>-Dfile.encoding=UTF-8</option>
										<option>--add-opens=java.base/java.nio.charset=ALL-UNNAMED</option>
										<option>--enable-native-access=ALL-UNNAMED</option>
										<option>-Xms512m</option>
										<option>-Xmx1g</option>
										<option>-XX:MaxMetaspaceSize=256m</option>
									</javaOptions>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>package-unix-rpm</id>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<configuration>
							<mainClass>ai.gebo.microservices.gateway.GatewayApplication</mainClass>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-jar-plugin</artifactId>
						<configuration>
							<archive>
								<manifest>
									<mainClass>ai.gebo.microservices.gateway.GatewayApplication</mainClass>
								</manifest>
							</archive>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<configuration>
							<jvmArguments>
								--add-opens=java.base/java.nio.charset=ALL-UNNAMED</jvmArguments>
							<mainClass>ai.gebo.microservices.gateway.GatewayApplication</mainClass>
							<excludeDevtools>false</excludeDevtools>
							<layout>JAR</layout>
							<classifier>bootable</classifier>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-resources-plugin</artifactId>
						<executions>
							<execution>
								<id>copy-jar</id>
								<phase>package</phase>
								<goals>
									<goal>copy-resources</goal>
								</goals>
								<configuration>
									<outputDirectory>${project.build.directory}/jpackage/lib</outputDirectory>
									<resources>
										<resource>
											<directory>${project.build.directory}</directory>
											<includes>
												<include>${project.build.finalName}-bootable.jar</include>
											</includes>
										</resource>
									</resources>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>build-helper-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>parse-project-version</id>
								<phase>initialize</phase>
								<goals>
									<goal>parse-version</goal>
								</goals>
								<configuration>
									<propertyPrefix>parsedVersion</propertyPrefix>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.panteleyev</groupId>
						<artifactId>jpackage-maven-plugin</artifactId>
						<version>1.7.1</version>
						<executions>
							<execution>
								<id>gebo-ai-gateway-rpm</id>
								<phase>package</phase>
								<goals>
									<goal>jpackage</goal>
								</goals>
								<configuration>
									<destination>${project.build.directory}/installer</destination>
									<input>${project.build.directory}/jpackage/lib</input>
									<mainJar>${project.build.finalName}-bootable.jar</mainJar>
									<name>gebo-ai-gateway</name>
									<linuxPackageName>gebo-ai-gateway</linuxPackageName>
									<type>RPM</type>
									<installDir>/home/gebo-ai-gateway</installDir>
									<linuxRpmGroup>Applications/Utilities</linuxRpmGroup>
									<linuxAppCategory>utils</linuxAppCategory>
									<launcherAsService>true</launcherAsService>
									<appVersion>${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}.${parsedVersion.buildNumber}</appVersion>
									<resourceDir>${project.basedir}/src/packaging/rpm/resources</resourceDir>
									<verbose>true</verbose>
									<javaOptions>
										<option>-Djava.net.preferIPv4Stack=true</option>
										<option>-Dspring.config.additional-location=file:/etc/gebo-ai-gateway/</option>
										<option>-Dsun.jnu.encoding=UTF-8</option>
										<option>-Dfile.encoding=UTF-8</option>
										<option>--add-opens=java.base/java.nio.charset=ALL-UNNAMED</option>
										<option>--enable-native-access=ALL-UNNAMED</option>
										<option>-Xms512m</option>
										<option>-Xmx1g</option>
										<option>-XX:MaxMetaspaceSize=256m</option>
									</javaOptions>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>package-windows</id>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<configuration>
							<mainClass>ai.gebo.microservices.gateway.GatewayApplication</mainClass>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-jar-plugin</artifactId>
						<configuration>
							<archive>
								<manifest>
									<mainClass>ai.gebo.microservices.gateway.GatewayApplication</mainClass>
								</manifest>
							</archive>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<configuration>
							<jvmArguments>
								--add-opens=java.base/java.nio.charset=ALL-UNNAMED</jvmArguments>
							<mainClass>ai.gebo.microservices.gateway.GatewayApplication</mainClass>
							<excludeDevtools>false</excludeDevtools>
							<layout>JAR</layout>
							<classifier>bootable</classifier>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>build-helper-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>parse-project-version</id>
								<phase>initialize</phase>
								<goals>
									<goal>parse-version</goal>
								</goals>
								<configuration>
									<propertyPrefix>parsedVersion</propertyPrefix>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-resources-plugin</artifactId>
						<executions>
							<execution>
								<id>copy-jar</id>
								<phase>package</phase>
								<goals>
									<goal>copy-resources</goal>
								</goals>
								<configuration>
									<outputDirectory>${project.build.directory}/jpackage/lib</outputDirectory>
									<resources>
										<resource>
											<directory>${project.build.directory}</directory>
											<includes>
												<include>${project.build.finalName}-bootable.jar</include>
											</includes>
										</resource>
									</resources>
								</configuration>
							</execution>
							<execution>
								<id>copy-msi-instance-resources</id>
								<phase>package</phase>
								<goals>
									<goal>copy-resources</goal>
								</goals>
								<configuration>
									<outputDirectory>${project.build.directory}/jpackage/lib/instance</outputDirectory>
									<resources>
										<resource>
											<directory>${project.basedir}/src/packaging/msi/instance</directory>
											<filtering>false</filtering>
										</resource>
									</resources>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.panteleyev</groupId>
						<artifactId>jpackage-maven-plugin</artifactId>
						<version>1.7.1</version>
						<executions>
							<execution>
								<id>gebo-ai-gateway-msi</id>
								<phase>package</phase>
								<goals>
									<goal>jpackage</goal>
								</goals>
								<configuration>
									<destination>${project.build.directory}/installer</destination>
									<input>${project.build.directory}/jpackage/lib</input>
									<mainJar>${project.build.finalName}-bootable.jar</mainJar>
									<name>gebo-ai-gateway</name>
									<type>MSI</type>
									<installDir>GeboAIGateway</installDir>
									<vendor>Gebo.ai</vendor>
									<appVersion>${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}.${parsedVersion.buildNumber}</appVersion>
									<winMenu>false</winMenu>
									<winShortcut>false</winShortcut>
									<winDirChooser>true</winDirChooser>
									<winConsole>true</winConsole>
									<launcherAsService>true</launcherAsService>
									<resourceDir>${project.basedir}/src/packaging/msi/resources</resourceDir>
									<verbose>true</verbose>
									<javaOptions>
										<option>-Duser.dir=$APPDIR\instance</option>
										<option>-Djava.net.preferIPv4Stack=true</option>
										<option>-Dspring.config.additional-location=file:$APPDIR\instance\config\</option>
										<option>-Dsun.jnu.encoding=UTF-8</option>
										<option>-Dfile.encoding=UTF-8</option>
										<option>--add-opens=java.base/java.nio.charset=ALL-UNNAMED</option>
										<option>--enable-native-access=ALL-UNNAMED</option>
										<option>-Xms512m</option>
										<option>-Xmx1g</option>
										<option>-XX:MaxMetaspaceSize=256m</option>
									</javaOptions>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
