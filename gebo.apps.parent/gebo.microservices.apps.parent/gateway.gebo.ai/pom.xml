<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.apps.microservices</groupId>
		<artifactId>gebo.microservices.apps.parent</artifactId>
		<version>1.0.2.1</version>
	</parent>
	<artifactId>gateway.gebo.ai</artifactId>

	<dependencies>
		<!-- Spring Cloud Gateway (reactive / WebFlux server) -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
		</dependency>
		<!-- Spring Cloud LoadBalancer -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-loadbalancer</artifactId>
		</dependency>
		<!-- Shared microservices topology: binds gebo.microservices.topology.*
		     from application.yml into a GeboMicroservicesTopology bean the gateway
		     can use to derive lb:// backends and per-service routing. -->
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.topology</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- Not pulled in transitively: the gateway depends on gebo.microservices.topology
		     directly rather than on gebo.microservices.starter, so telemetry (actuator +
		     Micrometer + tracing) has to be added explicitly here. -->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.telemetry</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!--
		  The Angular web UI. The gateway is the edge of the microservices
		  deployment, so it is the service that serves the UI to the browser:
		  gebo.ui is a plain jar whose Angular production build
		  (dist/gebo-ai-ui/browser) is packaged under static/, which Spring Boot
		  exposes as classpath:/static/ - index.html, the js/css bundles, favicon,
		  assets/ and media/. GeboUiRoutingConfig adds the SPA routing on top.

		  Deliberately NOT wrapped in an 'angular-ui' profile the way gebo.ai.app
		  does it: naming ANY profile on the command line deactivates Maven's
		  activeByDefault ones, and this service is normally packaged with an
		  explicit profile (-P bootables, -P docker for the Jib images). The UI
		  would then be dropped from the jar/image silently. Whether the UI is
		  actually built stays controlled where it belongs - by gebo.ui's own
		  angular-ui profile: with -P '!angular-ui' gebo.ui still produces a jar,
		  just without static/, and the gateway starts fine and logs that it has
		  no UI to serve.
		-->
		<dependency>
			<groupId>ai.gebo</groupId>
			<artifactId>gebo.ui</artifactId>
			<version>${project.version}</version>
		</dependency>
	</dependencies>

	<profiles>
		<!--
		  Swagger / OpenAPI UI. DISABLED by default, and deliberately so: a
		  production build must not ship an API console. Activate exactly like the
		  monolith and the backend services do, e.g.

		      mvn -P bootables,swagger-on package

		  Note this is the WEBFLUX springdoc starter, not the gebo.architecture.swagger
		  module the servlet services use - that one pulls springdoc's webmvc starter,
		  which cannot drive the reactive Spring Cloud Gateway.

		  With the profile off, springdoc is absent from the classpath, so no
		  /swagger-ui/** or /v3/api-docs is served AND GeboGatewaySwaggerRoutingConfig
		  (guarded by @ConditionalOnClass) registers no routes - the gateway then
		  exposes no path whatsoever to the backends' API specs.
		-->
		<profile>
			<id>swagger-on</id>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<dependencies>
				<dependency>
					<groupId>org.springdoc</groupId>
					<artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
					<version>${springdoc.version}</version>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>bootables</id>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>

						<configuration>
							<mainClass>ai.gebo.microservices.gateway.GatewayApplication</mainClass>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-jar-plugin</artifactId>
						<configuration>
							<archive>
								<manifest>
									<mainClass>ai.gebo.microservices.gateway.GatewayApplication</mainClass>
								</manifest>
							</archive>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>

						<configuration>
							<jvmArguments>
								--add-opens=java.base/java.nio.charset=ALL-UNNAMED</jvmArguments>
							<mainClass>ai.gebo.microservices.gateway.GatewayApplication</mainClass>
							<excludeDevtools>false</excludeDevtools>
							<layout>JAR</layout>

							<classifier>bootable</classifier>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>package-unix-deb</id>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<configuration>
							<mainClass>ai.gebo.microservices.gateway.GatewayApplication</mainClass>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-jar-plugin</artifactId>
						<configuration>
							<archive>
								<manifest>
									<mainClass>ai.gebo.microservices.gateway.GatewayApplication</mainClass>
								</manifest>
							</archive>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<configuration>
							<jvmArguments>
								--add-opens=java.base/java.nio.charset=ALL-UNNAMED</jvmArguments>
							<mainClass>ai.gebo.microservices.gateway.GatewayApplication</mainClass>
							<excludeDevtools>false</excludeDevtools>
							<layout>JAR</layout>
							<classifier>bootable</classifier>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-resources-plugin</artifactId>
						<executions>
							<execution>
								<id>copy-jar</id>
								<phase>package</phase>
								<goals>
									<goal>copy-resources</goal>
								</goals>
								<configuration>
									<outputDirectory>${project.build.directory}/jpackage/lib</outputDirectory>
									<resources>
										<resource>
											<directory>${project.build.directory}</directory>
											<includes>
												<include>${project.build.finalName}-bootable.jar</include>
											</includes>
										</resource>
									</resources>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.panteleyev</groupId>
						<artifactId>jpackage-maven-plugin</artifactId>
						<version>1.7.1</version>
						<executions>
							<execution>
								<id>gebo-ai-gateway-deb</id>
								<phase>package</phase>
								<goals>
									<goal>jpackage</goal>
								</goals>
								<configuration>
									<destination>${project.build.directory}/installer</destination>
									<input>${project.build.directory}/jpackage/lib</input>
									<mainJar>${project.build.finalName}-bootable.jar</mainJar>
									<name>gebo-ai-gateway</name>
									<linuxPackageName>gebo-ai-gateway</linuxPackageName>
									<type>DEB</type>
									<installDir>/home/gebo-ai-gateway</installDir>
									<linuxDebMaintainer>paolo.zavalloni@gebo.ai</linuxDebMaintainer>
									<linuxAppCategory>utils</linuxAppCategory>
									<launcherAsService>true</launcherAsService>
									<resourceDir>${project.basedir}/src/packaging/deb/resources</resourceDir>
									<appContentPaths>
										<path>${project.basedir}/src/packaging/deb/gebo-ai-gateway.service</path>
									</appContentPaths>
									<verbose>true</verbose>
									<javaOptions>
										<option>-Djava.net.preferIPv4Stack=true</option>
										<option>-Dspring.config.additional-location=file:/etc/gebo-ai-gateway/</option>
										<option>-Dsun.jnu.encoding=UTF-8</option>
										<option>-Dfile.encoding=UTF-8</option>
										<option>--add-opens=java.base/java.nio.charset=ALL-UNNAMED</option>
										<option>--enable-native-access=ALL-UNNAMED</option>
										<option>-Xms512m</option>
										<option>-Xmx1g</option>
										<option>-XX:MaxMetaspaceSize=256m</option>
									</javaOptions>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
