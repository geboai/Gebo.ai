<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.apps.microservices</groupId>
		<artifactId>gebo.microservices.apps.parent</artifactId>
		<version>1.0.4.0-SNAPSHOT</version>
	</parent>
	<artifactId>graphicator.gebo.ai</artifactId>

	<dependencies>
		<!-- Full LLMs microservice stack: LLM abstraction layer, microservices
		     environment, RabbitMQ bridge, models-replication cache and shared
		     topology. -->
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.llms.starter</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.ragsystem</groupId>
			<artifactId>gebo.ragsystem.content.graphrag_processor</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.graphrag.extraction.controllers</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- GraphicatorContextTest boots graphicator against a live Neo4j: it is the
		     service that WRITES the graph brain reads, so there is no meaningful
		     topology for it with GraphRAG off, and with it on Neo4jDdlRunner executes
		     the graph DDL as an ApplicationRunner during startup - the context cannot
		     load without a reachable graph store. The Mongo/JUnit testcontainers deps
		     are inherited from gebo.microservices.apps.parent; graphicator and brain
		     are the only two microservices that also need this one. -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-neo4j</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<profiles>
		<!-- Bootable fat jar WITH the OpenAPI/Swagger UI (classifier bootable+swagger). -->
		<profile>
			<id>swagger-on</id>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<configuration>
							<jvmArguments>
								--add-opens=java.base/java.nio.charset=ALL-UNNAMED</jvmArguments>
							<mainClass>ai.gebo.microservices.graphicator.GraphicatorApplication</mainClass>
							<excludeDevtools>false</excludeDevtools>
							<layout>JAR</layout>
							<classifier>bootable+swagger</classifier>
						</configuration>
					</plugin>
				</plugins>
			</build>
			<dependencies>
				<dependency>
					<groupId>ai.gebo.architecture</groupId>
					<artifactId>gebo.architecture.swagger</artifactId>
					<version>${project.version}</version>
				</dependency>
			</dependencies>
		</profile>
		<!-- Bootable fat jar (classifier bootable). -->
		<profile>
			<id>bootables</id>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<configuration>
							<mainClass>ai.gebo.microservices.graphicator.GraphicatorApplication</mainClass>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-jar-plugin</artifactId>
						<configuration>
							<archive>
								<manifest>
									<mainClass>ai.gebo.microservices.graphicator.GraphicatorApplication</mainClass>
								</manifest>
							</archive>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<configuration>
							<jvmArguments>
								--add-opens=java.base/java.nio.charset=ALL-UNNAMED</jvmArguments>
							<mainClass>ai.gebo.microservices.graphicator.GraphicatorApplication</mainClass>
							<excludeDevtools>false</excludeDevtools>
							<layout>JAR</layout>
							<classifier>bootable</classifier>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
