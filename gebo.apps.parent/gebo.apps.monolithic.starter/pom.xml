			<artifactId>gebo.architecture.fastsetup.system</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo</groupId>
			<artifactId>gebo.config.services</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.security.controllers</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.multilanguage.support</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.documents.cache</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.agents.abstraction.layer</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.agents.standard</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.neo4j</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.mcp-clients</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.mcp-server</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- user-messages-concentrator-component, externalized out of gebo.core onto
		     its own jobs-master-module - see GWorkflowsConcentratorMessagesReceiverFactory.
		     gebo.core no longer carries it, so this is required, not optional, for
		     content-processing status/workflow-completion to keep working at all. -->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.compute.workflow</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- Config-driven standard-workflow step enablement (monolith variant of the
		     enablement policy extracted from the perform-modules). -->
