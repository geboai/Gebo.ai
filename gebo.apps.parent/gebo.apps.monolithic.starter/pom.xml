<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.apps</groupId>
		<artifactId>gebo.apps.parent</artifactId>
		<version>1.0.2.1-SNAPSHOT</version>
	</parent>
	<artifactId>gebo.apps.monolithic.starter</artifactId>
	<dependencies>
		<!-- Generated API keys (model + repository + service + the two controllers).
		     Owner-only: a key IS a LOCAL_JWT, so nothing on the request path needs the
		     key store - only minting, listing and revoking do, and those are admin acts. -->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.security.apikey</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- The monolith OWNS the ACL store: it reads AND allocates aliases in Mongo.
		     (A microservice that does not own it takes gebo.microservices.acl.client
		     instead - a service depends on exactly one of the two.) -->
		<dependency>
			<groupId>ai.gebo.core</groupId>
			<artifactId>gebo.acl.mongo</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- The monolith OWNS the user store: it reads the directory from Mongo directly.
		     (A microservice that does not own it takes gebo.microservices.security.client
		     instead - a service depends on exactly one of the two.) -->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.security.directory.mongo</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.ragsystem</groupId>
			<artifactId>gebo.ragsystem.starter</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.webconfig</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.secrets.impl</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.systems</groupId>
			<artifactId>gebo.contentsystems.starter</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.buildsystems</groupId>
			<artifactId>gebo.buildsystems.starter</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>ai.gebo.ragsystem</groupId>
			<artifactId>gebo.ragsystem.content.vectorizator</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.llms</groupId>
			<artifactId>gebo.llms.starter</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- The concrete, mapped admin controllers split out of
		     gebo.architecture.llms.abstraction.layer (ChatModelsController,
		     EmbeddingModelsControllers, ImageModelsController,
		     RankerModelsController, TextToSpeechModelsController,
		     TranscriptModelsController, ChatModelsLookupController,
		     FunctionsLookupController) - the base/abstract classes they extend
		     stay in the abstraction layer itself and are pulled in transitively. -->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.llms.abstraction.layer.controllers</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- Every LLM provider driver's admin controllers (OpenAIChatModelsConfigurationController,
		     ...), split out of each gebo.llms.<provider> module the same way. -->
		<dependency>
			<groupId>ai.gebo.llms</groupId>
			<artifactId>gebo.llms.controllers.starter</artifactId>
			<version>${project.version}</version>
		</dependency>
		
		<!-- LLM fast-setup: NOT part of gebo.llms.starter (it carries a concrete
		     @RestController, GeboFastLLMSSetupController, and gebo.llms.starter
		     is also consumed by every LLM-hosting microservice via
		     gebo.microservices.llms.starter) - wired directly here instead,
		     same as on brain.gebo.ai. -->
		<dependency>
			<groupId>ai.gebo.llms</groupId>
			<artifactId>gebo.llms.setup</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.core</groupId>
			<artifactId>gebo.core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo</groupId>
			<artifactId>gebo.config</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.secrets.services</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.angular.persistence.support</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.environment.monolithic</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
