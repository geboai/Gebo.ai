<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>ai.gebo</groupId>
	<artifactId>ai.gebo.parent</artifactId>
	<version>1.0.6.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
	</parent>
	<properties>
		<java.version>21</java.version>
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>
		<!-- TODO: Test if works ok
		<org.eclipse.jgit.version>6.10.1.202505221210-r</org.eclipse.jgit.version> -->
		<org.eclipse.jgit.version>7.3.0.202506031305-r</org.eclipse.jgit.version>
		<apache-poi.version>5.5.1</apache-poi.version>
		<spring.ai.version>2.0.2</spring.ai.version>
		<springdoc.version>3.0.3</springdoc.version>
		<!-- Official Agent2Agent (A2A) Java SDK (org.a2aproject.sdk, the current group;
		     the old io.github.a2asdk group is frozen at 0.3.x). gebo.architecture.a2a-*
		     consume ONLY a2a-java-sdk-spec (the Gson wire types: AgentCard, Message/Part,
		     Task, JSON-RPC envelopes). The SDK's transports are deliberately NOT used:
		     server-common pulls quarkus-arc + CDI, and the client umbrella pulls Vert.x +
		     gRPC + protobuf. Both a2a modules serve/consume JSON-RPC + SSE over Spring
		     instead, keeping one clean SDK dependency. The SDK BOM is deliberately NOT
		     imported (it manages junit/mockito at test scope and would leak into the
		     whole reactor); the a2a module poms pin this version on their single dep. -->
		<a2a.sdk.version>1.3.0.Final</a2a.sdk.version>
		<!-- Required, not an override: gebo.ranker.api and
		     gebo.architecture.llms.abstraction.layer declare spring-retry with
		     <version>${spring-retry.version}</version>, and Spring Boot does not
		     manage spring-retry, so the build does not resolve without it. 2.0.13 is
		     the current release (it also carries the fix for CVE-2026-41710). -->
		<spring-retry.version>2.0.13</spring-retry.version>
		<!-- Security fixes are normally taken by bumping spring-boot-starter-parent
		     (and spring.ai.version), NOT by pinning single libraries: an override
		     drifts out of date and starts pinning its library DOWN once the parent
		     moves past it. Boot 4.1.2 did exactly that to the tomcat (11.0.25 pinned,
		     11.0.27 managed), netty (4.2.18.Final pinned, 4.2.19.Final managed) and
		     jackson (3.1.7 / 2.21.7, now managed) pins, which are gone. The pins
		     below are the exceptions, each with the condition under which it must go.
		     MongoDB Java driver: Boot 4.1.2 still manages 5.8.1, affected by
		     CVE-2026-18710 (a credential could be written to log output, fixed in
		     5.9.2) and by CVE-2026-88032 / CVE-2026-88033 (use-after-free in reactive
		     client-side encryption, GridFS query injection), fixed only from 5.11.1 -
		     there is no backport to an older minor.
		     DROP this property as soon as the parent manages 5.11.1 or later. -->
		<mongodb.version>5.11.1</mongodb.version>
		<!-- Hazelcast: Boot 4.1.2 manages 5.5.0, affected by CVE-2026-107726
		     (critical, arbitrary member memory access by a low-privileged client) and
		     CVE-2026-107725 (authorization bypass in the IMap predicates API), both
		     fixed only in 5.7.0 (GA, same 5.x API, still Apache 2.0).
		     DROP this property as soon as the parent manages 5.7.0 or later. -->
		<hazelcast.version>5.7.0</hazelcast.version>
		<!-- OpenTelemetry: Boot 4.1.2 manages 1.62.0, affected by CVE-2026-118259
		     (quadratic CPU in W3C tracestate parsing, reachable from any inbound
		     request header), fixed in 1.67.0. The API is the stable 1.x line, so
		     the jump stays compatible with the micrometer tracing bridge.
		     DROP this property as soon as the parent manages 1.67.0 or later. -->
		<opentelemetry.version>1.67.0</opentelemetry.version>
		<!-- RabbitMQ Java client (microservices, via spring-boot-starter-amqp): Boot
		     4.1.2 manages 5.30.0, affected by CVE-2026-69219, -69220, -63337, -75516
		     (high) and six moderate/low advisories published 2026-08..10; the last
		     of them (CVE-2026-106121) is fixed after 5.36.0, and 5.37.0 is the first
		     release past it. Same 5.x line spring-amqp is built against.
		     DROP this property as soon as the parent manages 5.37.0 or later. -->
		<rabbit-amqp-client.version>5.37.0</rabbit-amqp-client.version>
		<!-- Derby: Boot 4.1.2 manages 10.16.1.1, affected by CVE-2022-46337
		     (critical, LDAP injection in the authenticator). The 10.16.1.2 fix was
		     never published to Maven Central; 10.17.1.0 carries it, needs Java 21
		     (the build already targets it) and is still Derby's latest release. Kept
		     here with the other pins so every edition built on this parent gets it.
		     DROP once the parent manages 10.17.1.0 or later. -->
		<derby.version>10.17.1.0</derby.version>
		<maven-source-plugin.version>3.3.0</maven-source-plugin.version>
		<maven-javadoc-plugin.version>3.6.0</maven-javadoc-plugin.version>
		<version.swagger.codegen>2.4.44</version.swagger.codegen>
		<!-- Bouncy Castle expects its bc* artifacts to move as a matched set; see the
		     dependencyManagement entries below. bcprov ships an extra patch release
		     (1.85.2) that the other artifacts don't, so the provider carries its own
		     property — that pairing is the combination BC itself publishes. -->
		<bouncycastle.version>1.85</bouncycastle.version>
		<bouncycastle.prov.version>1.85.2</bouncycastle.prov.version>
		<maven.compiler.release></maven.compiler.release>
	</properties>
	<modules>
		<module>gebo.boot</module>
		<module>gebo.systems.parent</module>
		<module>gebo.ragsystem.parent</module>
		<module>gebo.architecture.parent</module>
		<module>gebo.ui</module>
		<module>gebo.js-plugins</module>
		<module>gebo.config</module>
		<module>gebo.config.services</module>
		<module>gebo.core.parent</module>
		<module>gebo.apps.parent</module>
		<module>gebo.modules.pocs</module>
		<module>gebo.integrations.clients</module>
		<module>gebo.llms.parent</module>
		<module>gebo.buildsystems.parent</module>
		<module>gebo.api.clients</module>
		<module>gebo.microservices.architecture.parent</module>
	</modules>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- https://mvnrepository.com/artifact/org.projectlombok/lombok -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>

	</dependencies>

	<repositories>
		<repository>
			<id>spring-milestones</id>
			<name>Spring Milestones</name>
			<url>https://repo.spring.io/milestone</url>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>
		<repository>
			<id>spring-snapshots</id>
			<name>Spring Snapshots</name>
			<url>https://repo.spring.io/snapshot</url>
			<releases>
				<enabled>false</enabled>
			</releases>
		</repository>


	</repositories>
	<build>
		<pluginManagement>
			<plugins>

				<!-- === lombok annotation processor === -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
							</path>
							<!-- Generates META-INF/spring-autoconfigure-metadata.properties, which
							     AutoConfigurationSorter reads to honour @AutoConfigureAfter/@AutoConfigureBefore.
							     Explicit annotationProcessorPaths (added above for lombok) disables Maven's
							     automatic classpath-based processor discovery, so without this entry every
							     such annotation in the codebase is silently ignored. -->
							<path>
								<groupId>org.springframework.boot</groupId>
								<artifactId>spring-boot-autoconfigure-processor</artifactId>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>

				<!-- === sources === -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-source-plugin</artifactId>
					<version>${maven-source-plugin.version}</version>
					<executions>
						<execution>
							<id>attach-sources</id>
							<phase>verify</phase>
							<goals>
								<goal>jar</goal> <!-- produces *.jar with sources -->
							</goals>
						</execution>
					</executions>
				</plugin>

				<!-- === javadoc === -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-javadoc-plugin</artifactId>
					<version>${maven-javadoc-plugin.version}</version>
					<executions>
						<execution>
							<id>attach-javadocs</id>
							<phase>verify</phase>
							<goals>
								<goal>jar</goal> <!-- produces *.jar with javadoc -->
							</goals>
						</execution>
					</executions>
				</plugin>

			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<finalName>
						${project.groupId}-${project.artifactId}-${project.version}</finalName>
				</configuration>
			</plugin>

		</plugins>
	</build>
	<profiles>
		<profile>
			<id>native</id>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<properties>
				<skipTests>true</skipTests>
			</properties>
		</profile>
	</profiles>
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>GitHub Gebo.ai Apache Maven Packages</name>
			<url>https://maven.pkg.github.com/geboai/Gebo.ai</url>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</distributionManagement>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>io.modelcontextprotocol.sdk</groupId>
				<artifactId>mcp-bom</artifactId>
				<version>2.0.0</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- Tika arrives transitively through io.github.twwch:markdown2office, which
			     asks for 3.2.2 while dragging tika-langdetect-optimaize 3.2.3 — the family
			     was already resolving out of sync. 3.2.x is affected by CVE-2026-66755
			     (tika-core and tika-langdetect-optimaize); 3.3.2 is the fix and stays on
			     the same major. Importing the BOM keeps every tika-* artifact on one
			     version instead of pinning them one by one, and it also lifts junrar:
			     tika-parent 3.3.2 sets junrar.version=7.6.0, above the 7.5.10 that fixes
			     CVE-2026-41245 (for the later CVE-2026-86071 see the junrar pin below). -->
			<dependency>
				<groupId>org.apache.tika</groupId>
				<artifactId>tika-bom</artifactId>
				<version>3.3.2</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- junrar 7.6.0, the version tika 3.3.2 brings, is affected by CVE-2026-86071
			     (LocalFolderExtractor mkdir escape, low); 7.6.1 is the fix, and no tika 3.3.x
			     newer than 3.3.2 exists to bring it (the next line is 4.0.0). A version
			     declared here wins over the imported tika-bom. DROP this once tika-bom
			     manages 7.6.1 or later. -->
			<dependency>
				<groupId>com.github.junrar</groupId>
				<artifactId>junrar</artifactId>
				<version>7.6.1</version>
			</dependency>
			<!-- opentelemetry-semconv is pulled transitively at 1.41.1, which is inside the
			     range of CVE-2026-39883 (>=1.15.0,<1.43.0). Spring Boot manages the
			     OpenTelemetry BOM but not this artifact, which versions on its own line.
			     1.43.0 is the fix; the artifact carries generated attribute constants, so
			     moving it does not change behaviour. -->
			<dependency>
				<groupId>io.opentelemetry.semconv</groupId>
				<artifactId>opentelemetry-semconv</artifactId>
				<version>1.43.0</version>
			</dependency>
			<!-- gebo.architecture.llms.abstraction.layer pins okhttp:4.12.0, which pulls
			     okio-jvm:3.6.0; the OpenTelemetry okhttp sender (auto-configured on every
			     microservice via tracing) pulls okhttp-jvm:5.3.2, which requires
			     okio-jvm:3.16.4. Without this override, Maven's nearest-wins mediation
			     keeps the older 3.6.0 on the runtime classpath alongside okhttp-jvm 5.3.2,
			     which is missing the Socket-based Okio.socket(Socket) overload that
			     version calls, failing with NoSuchMethodError at embedding-model/vector
			     store initialization. 3.16.4 satisfies both okhttp consumers. -->
			<dependency>
				<groupId>com.squareup.okio</groupId>
				<artifactId>okio</artifactId>
				<version>3.16.4</version>
			</dependency>
			<dependency>
				<groupId>com.squareup.okio</groupId>
				<artifactId>okio-jvm</artifactId>
				<version>3.16.4</version>
			</dependency>
			<!-- gebo.architecture.crypting, gebo.secrets.services and gebo.secrets.impl
			     each hardcoded their own bcprov/bcpkix version (1.84 vs 1.78.1), so
			     nearest-wins mediation put bcprov 1.78.1 on the assembled app's runtime
			     classpath next to bcpkix 1.81.1 and bcpg 1.84 — an unsupported mix, and
			     an outdated provider the module poms gave no hint of. Managing all five
			     bc* artifacts here pins the transitive ones (bcutil, bcjmail) too, so
			     the set can only move together. -->
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcprov-jdk18on</artifactId>
				<version>${bouncycastle.prov.version}</version>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcpkix-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcpg-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcutil-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcjmail-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>
			<!-- Three modules each hardcoded their own jsoup - 1.18.1 in
			     gebo.architecture.search.abstraction.layer and gebo.llms.standard.functions,
			     1.20.1 in gebo.system.ingestion - so nearest-wins mediation put the oldest,
			     1.18.1, on the assembled app's runtime classpath. Those direct declarations
			     also override the tika-bom imported above, which manages 1.22.2, so the
			     module pins were actively holding jsoup down. 1.18.1 is affected by
			     CVE-2026-71497 (Cleaner may emit active markup for custom Safelists that
			     permit raw-text elements); 1.23.1 is the fix and 1.23.2 is current. Managing
			     it here means the three consumers can only move together. -->
			<dependency>
				<groupId>org.jsoup</groupId>
				<artifactId>jsoup</artifactId>
				<version>1.23.2</version>
			</dependency>
			<!-- Guava reaches the apps from six directions at six versions: 18.0 through
			     tika-langdetect-optimaize's language-detector 0.6 (in every module that
			     ingests content), 31.1-jre via google-api-client, 33.1.0-jre via the
			     Google Workspace handlers, 33.5.0-jre via spring-ai-vertex-ai-embedding,
			     33.6.0-android via grpc and 33.6.0-jre via microsoft-graph. All of them
			     are affected by CVE-2026-102554 (high, CompactHashMap/MapMakerInternal),
			     and 18.0 also by CVE-2018-10237 and CVE-2023-2976. 33.7.2-jre is the fix;
			     the -jre flavour is a superset of -android, and language-detector only
			     uses collection basics that 33.x still has.
			     DROP once every consumer above brings 33.7.2 or later on its own. -->
			<dependency>
				<groupId>com.google.guava</groupId>
				<artifactId>guava</artifactId>
				<version>33.7.2-jre</version>
			</dependency>
			<!-- commons-io had no managed version: gebo.architecture.crypting and
			     gebo.system.ingestion hardcoded 2.18.0 and 2.19.0, and nearest-wins
			     mediation left 2.11.0 in the build-system handler (via maven-invoker
			     3.3.0) and 2.13.0 behind milton 4.0.x, both affected by CVE-2024-47554
			     (high, XmlStreamReader DoS, fixed 2.14.0).
			     2.20.0 is the highest the build already ran on (testcontainers 2.x asks
			     for it); the module versions are gone, so every consumer moves with it. -->
			<dependency>
				<groupId>commons-io</groupId>
				<artifactId>commons-io</artifactId>
				<version>2.20.0</version>
			</dependency>
			<!-- commons-compress: testcontainers 1.20.4, still used by some test
			     scopes, drags 1.24.0, affected by CVE-2024-25710 and CVE-2024-26308
			     (fixed 1.26.0); most modules already resolve 1.28.0 through poi-ooxml,
			     and gebo.apps.monolithic.starter no longer hardcodes 1.27.1. -->
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-compress</artifactId>
				<version>1.28.0</version>
			</dependency>
			<!-- commons-beanutils: opencsv 5.10 brings 1.10.0 (and milton 4.0.x brought
			     1.9.4), affected by CVE-2025-48734 (high, declared-class access
			     through PropertyUtils, fixed 1.11.0), the version every other module
			     already resolves. -->
			<dependency>
				<groupId>commons-beanutils</groupId>
				<artifactId>commons-beanutils</artifactId>
				<version>1.11.0</version>
			</dependency>
			<!-- Apache HttpClient 4: eureka-client 2.0.6, in every microservice through
			     spring-cloud-starter-netflix-eureka-client, still asks for 4.5.3, affected
			     by CVE-2020-13956 (fixed 4.5.13). 4.5.14 is the last 4.x release and the
			     version the modules declaring httpclient already use; Spring Boot 4 no
			     longer manages the 4.x line. -->
			<dependency>
				<groupId>org.apache.httpcomponents</groupId>
				<artifactId>httpclient</artifactId>
				<version>4.5.14</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
