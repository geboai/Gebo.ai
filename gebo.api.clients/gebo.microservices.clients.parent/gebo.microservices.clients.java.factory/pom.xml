			<artifactId>chunker.gebo.ai.java.client</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>gebo.microservices.api.clients</groupId>
			<artifactId>git.gebo.ai.java.client</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>gebo.microservices.api.clients</groupId>
			<artifactId>filesystem.gebo.ai.java.client</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
