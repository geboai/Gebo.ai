			<artifactId>uploads.gebo.ai.java.client</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>gebo.microservices.api.clients</groupId>
			<artifactId>userspace.gebo.ai.java.client</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
