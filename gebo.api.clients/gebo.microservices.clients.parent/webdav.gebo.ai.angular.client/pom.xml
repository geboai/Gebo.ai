<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>gebo.microservices.api.clients</groupId>
		<artifactId>gebo.microservices.clients.parent</artifactId>
		<version>1.0.3.0-SNAPSHOT</version>
	</parent>
	<artifactId>webdav.gebo.ai.angular.client</artifactId>
	<packaging>jar</packaging>

	<properties>
		<swagger.file>http://localhost:13020/webdav/v3/api-docs</swagger.file>
		<generated-sources-path>${project.basedir}/projects/gebo-webdav-api/src/lib</generated-sources-path>
	</properties>

	<profiles>
		<profile>
			<id>angular-ui</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>com.github.eirslett</groupId>
						<artifactId>frontend-maven-plugin</artifactId>
						<version>1.7.6</version>
						<configuration>
							<workingDirectory>./</workingDirectory>
							<nodeVersion>v22.14.0</nodeVersion>
							<npmVersion>10.9.2</npmVersion>
						</configuration>
						<executions>
							<execution>
								<id>install node and npm</id>
								<goals>
									<goal>install-node-and-npm</goal>
								</goals>
							</execution>
							<execution>
								<id>npm install</id>
								<goals>
									<goal>npm</goal>
								</goals>
								<configuration>
									<arguments>install</arguments>
								</configuration>
							</execution>
							<execution>
								<id>npm run build-lib</id>
								<goals>
									<goal>npm</goal>
								</goals>
								<configuration>
									<arguments>run build-lib</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>generate-rest-api</id>
			<build>
				<plugins>
					<plugin>
						<groupId>io.swagger.codegen.v3</groupId>
						<artifactId>swagger-codegen-maven-plugin</artifactId>
						<version>${swagger.codegen.plugin.version.angular}</version>
						<configuration>
							<inputSpec>${swagger.file}</inputSpec>
							<!-- Overrides only encoder.mustache; every other file falls back to
							     swagger-codegen's built-in template. Its stock encoder targets
							     Angular 10 and omits the 'override' modifiers this project's
							     TypeScript requires (error TS4114). -->
							<templateDirectory>${project.basedir}/../../swagger-codegen-templates/typescript-angular</templateDirectory>
							<configOptions>
								<sourceFolder>${generated-sources-angular-path}</sourceFolder>
							</configOptions>
							<output>${generated-sources-path}</output>
						</configuration>
						<executions>
							<execution>
								<id>generate-swagger-angular</id>
								<phase>generate-sources</phase>
								<goals>
									<goal>generate</goal>
								</goals>
								<configuration>
									<language>typescript-angular</language>
									<modelPackage>model</modelPackage>
									<apiPackage>api</apiPackage>
									<invokerPackage>invoker</invokerPackage>
									<additionalProperties>
										ngVersion=10.0.6,libraryName=gebo.microservices.api.client.webdav</additionalProperties>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
