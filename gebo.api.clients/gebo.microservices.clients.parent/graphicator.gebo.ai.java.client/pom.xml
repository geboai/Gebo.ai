<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>gebo.microservices.api.clients</groupId>
		<artifactId>gebo.microservices.clients.parent</artifactId>
		<version>1.0.2.2-SNAPSHOT</version>
	</parent>
	<artifactId>graphicator.gebo.ai.java.client</artifactId>
	<packaging>jar</packaging>

	<properties>
		<swagger.file>http://localhost:13003/graphicator/v3/api-docs</swagger.file>
		<generated-sources-path>${project.basedir}</generated-sources-path>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-json</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.13.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>javax.annotation</groupId>
			<artifactId>javax.annotation-api</artifactId>
			<version>1.3.2</version>
		</dependency>
		<dependency>
			<groupId>io.swagger.core.v3</groupId>
			<artifactId>swagger-annotations</artifactId>
			<version>2.2.42</version>
		</dependency>
	</dependencies>

	<profiles>
		<profile>
			<id>generate-rest-api</id>
			<build>
				<plugins>
					<plugin>
						<groupId>io.swagger.codegen.v3</groupId>
						<artifactId>swagger-codegen-maven-plugin</artifactId>
						<version>${swagger.codegen.plugin.version.java}</version>
						<configuration>
							<inputSpec>${swagger.file}</inputSpec>
							<templateDirectory>
								${project.basedir}/../../swagger-codegen-templates/java-resttemplate</templateDirectory>
							<configOptions>
								<sourceFolder>${generated-sources-java-path}</sourceFolder>
							</configOptions>
							<output>${generated-sources-path}</output>
						</configuration>
						<executions>
							<execution>
								<id>generate-swagger-angular</id>
								<phase>generate-sources</phase>
								<goals>
									<goal>generate</goal>
								</goals>
								<configuration>
									<language>java</language>
									<library>resttemplate</library>
									<java8>true</java8>
									<dateLibrary>java8</dateLibrary>
									<useJakartaEe>true</useJakartaEe>
									<jakarta>true</jakarta>
									<modelPackage>
										gebo.microservices.api.client.graphicator.model</modelPackage>
									<apiPackage>
										gebo.microservices.api.client.graphicator.api</apiPackage>
									<invokerPackage>
										gebo.microservices.api.client.graphicator.invoker</invokerPackage>
									<additionalProperties>
										java8=true,dateLibrary=legacy,OffsetDateTime=java.time.OffsetDateTime,ngVersion=10.0.6,libraryName=resttemplate</additionalProperties>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
