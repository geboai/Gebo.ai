@echo off
REM ==========================================================================
REM build-sbom-images.bat — Build gebo.ai Docker images with SBOM attestations
REM ==========================================================================
REM
REM Generates CycloneDX SBOMs as OCI attestations attached to each image using
REM docker buildx --sbom. The Maven-built SBOM (application.cdx.json) is also
REM COPY'd into each image at /opt/gebo.ai/sbom.cdx.json as before, so the SBOM
REM is available both as a standard BuildKit attestation and as an in-image file.
REM
REM Usage:
REM   build-sbom-images.bat                    (build all 3 images, --push)
REM   build-sbom-images.bat platform            (build only geboai/platform)
REM   build-sbom-images.bat gebo.ai             (build only geboai/gebo.ai)
REM   build-sbom-images.bat easyinstall         (build only geboai/easyinstall.gebo.ai)
REM   build-sbom-images.bat all --load          (single-platform, local daemon)
REM   build-sbom-images.bat all --platforms linux/amd64
REM
REM Prerequisites:
REM   - docker buildx enabled:  docker buildx create --use --name sbom-builder
REM   - The monolith bootable+swagger jar built:
REM       mvn clean install -DskipTests
REM       mvn -f gebo.apps.parent\gebo.ai.app\pom.xml -P swagger-on package -DskipTests
REM
REM --------------------------------------------------------------------------

setlocal enabledelayedexpansion

set "REPO_ROOT=%~dp0.."
set "VERSION=1.0.2.1-SNAPSHOT"
set "PLATFORMS=linux/amd64,linux/arm64"
set "JAR=%REPO_ROOT%\gebo.apps.parent\gebo.ai.app\target\gebo.ai.app-%VERSION%-bootable.jar"
set "SBOM=%REPO_ROOT%\gebo.apps.parent\gebo.ai.app\target\classes\META-INF\sbom\application.cdx.json"

set "PUSH=0"
set "LOAD=0"
set "TARGET=%~1"
if "%TARGET%"=="" set "TARGET=all"

REM Parse args
:parse_args
shift
if "%~1"=="" goto :args_done
if /i "%~1"=="--push" ( set "PUSH=1" & goto :parse_args )
if /i "%~1"=="--load" ( set "LOAD=1" & goto :parse_args )
if /i "%~1"=="--platforms" ( set "PLATFORMS=%~2" & shift & goto :parse_args )
if /i "%~1"=="platform" ( set "TARGET=platform" & goto :parse_args )
if /i "%~1"=="gebo.ai" ( set "TARGET=gebo.ai" & goto :parse_args )
if /i "%~1"=="easyinstall" ( set "TARGET=easyinstall" & goto :parse_args )
if /i "%~1"=="all" ( set "TARGET=all" & goto :parse_args )
echo Unknown arg: %~1
exit /b 1
:args_done

REM Build action
set "ACTION="
if "%PUSH%"=="1" (
  set "ACTION=--push"
) else if "%LOAD%"=="1" (
  set "ACTION=--load"
  set "PLATFORMS=linux/amd64"
)

if "%ACTION%"=="" (
  echo ERROR: specify --push or --load
  exit /b 1
)

REM Verify artifacts
:check_artifacts
if not exist "%JAR%" (
  echo ERROR: Bootable jar not found at %JAR%
  echo Build it first:  mvn -f gebo.apps.parent\gebo.ai.app\pom.xml -P swagger-on package -DskipTests
  exit /b 1
)
if not exist "%SBOM%" (
  echo ERROR: SBOM not found at %SBOM%
  echo It is generated by the cyclonedx-maven-plugin during the build.
  exit /b 1
)
goto :check_artifacts_done

:check_artifacts_done
if /i "%TARGET%"=="platform" goto :build_platform
if /i "%TARGET%"=="gebo.ai" goto :build_gebo_ai
if /i "%TARGET%"=="easyinstall" goto :build_easyinstall
if /i "%TARGET%"=="all" goto :build_all
echo Unknown target: %TARGET% ^(use: platform, gebo.ai, easyinstall, or all^)
exit /b 1

:build_platform
echo === Building geboai/platform:2.5 with SBOM (%PLATFORMS%) ===
docker buildx build --platform %PLATFORMS% --sbom=true -t geboai/platform:2.5 %ACTION% "%REPO_ROOT%\dockers\gebo.ai.platform"
if /i "%TARGET%"=="platform" goto :done
goto :build_gebo_ai

:build_gebo_ai
if not exist "%JAR%" goto :check_artifacts
echo === Building geboai/gebo.ai with SBOM (%PLATFORMS%) ===
copy /Y "%JAR%" "%REPO_ROOT%\dockers\gebo.ai\"
copy /Y "%SBOM%" "%REPO_ROOT%\dockers\gebo.ai\"
docker buildx build --platform %PLATFORMS% --sbom=true -t geboai/gebo.ai -t geboai/gebo.ai:%VERSION% %ACTION% "%REPO_ROOT%\dockers\gebo.ai"
if /i "%TARGET%"=="gebo.ai" goto :done
goto :build_easyinstall

:build_easyinstall
if not exist "%JAR%" goto :check_artifacts
echo === Building geboai/easyinstall.gebo.ai with SBOM (%PLATFORMS%) ===
copy /Y "%JAR%" "%REPO_ROOT%\dockers\easyinstall.gebo.ai\"
copy /Y "%SBOM%" "%REPO_ROOT%\dockers\easyinstall.gebo.ai\"
docker buildx build --platform %PLATFORMS% --sbom=true -t geboai/easyinstall.gebo.ai -t geboai/easyinstall.gebo.ai:%VERSION% %ACTION% "%REPO_ROOT%\dockers\easyinstall.gebo.ai"
if /i "%TARGET%"=="easyinstall" goto :done

:build_all
REM All three built in sequence above — nothing more to do
goto :done

:done
echo === Done ===
echo.
echo Inspect SBOM attestations with:
echo   docker buildx imagetools inspect geboai/gebo.ai:%VERSION% --format json
exit /b 0
