<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.integrations.clients</groupId>
		<artifactId>gebo.integrations.clients.parent</artifactId>
		<version>1.0.7.0-SNAPSHOT</version>
	</parent>
	<artifactId>gebo.gitlab.client</artifactId>
	<description>GitLab REST API v4, OpenAPI v3 description (YAML spec) client, generated with OpenAPI Generator (java, restclient on Spring Boot 4 / Jackson 3).</description>
	<properties>
		<!-- Regenerate with: mvn -P generate-rest-api generate-sources
		     (override the spec with -Dswagger.file=<url or path>) -->
		<!-- The GitLab spec is about 5 MB, over the 3 MB (3145728 code points)
		     YAML limit of the swagger parser: the profile raises it. -->
		<openapi.maxYamlCodePoints>20000000</openapi.maxYamlCodePoints>
		<swagger.file>https://gitlab.com/gitlab-org/gitlab/-/raw/master/doc/api/openapi/openapi_v3.yaml</swagger.file>
	</properties>
	<packaging>jar</packaging>
	<dependencies>
		<!-- Spring Framework 7 RestClient and Jackson 3 (versions from Spring Boot) -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-context</artifactId>
		</dependency>
		<dependency>
			<groupId>tools.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<dependency>
			<groupId>jakarta.annotation</groupId>
			<artifactId>jakarta.annotation-api</artifactId>
		</dependency>
	</dependencies>

	<profiles>
		<profile>
			<id>generate-rest-api</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>properties-maven-plugin</artifactId>
						<version>1.4.0</version>
						<executions>
							<execution>
								<id>raise-yaml-code-points-limit</id>
								<phase>initialize</phase>
								<goals>
									<goal>set-system-properties</goal>
								</goals>
								<configuration>
									<properties>
										<property>
											<name>maxYamlCodePoints</name>
											<value>${openapi.maxYamlCodePoints}</value>
										</property>
									</properties>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.openapitools</groupId>
						<artifactId>openapi-generator-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>generate-gitlab-client</id>
								<phase>generate-sources</phase>
								<goals>
									<goal>generate</goal>
								</goals>
								<configuration>
									<inputSpec>${swagger.file}</inputSpec>
									<modelPackage>ai.gebo.gitlab.client.model</modelPackage>
									<apiPackage>ai.gebo.gitlab.client.api</apiPackage>
									<invokerPackage>ai.gebo.gitlab.client.invoker</invokerPackage>
									<!-- 32 arrays of the GitLab spec have no `items`: validation
									     fails on them, the generator types them List<String>. -->
									<skipValidateSpec>true</skipValidateSpec>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
