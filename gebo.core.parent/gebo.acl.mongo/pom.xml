<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.core</groupId>
		<artifactId>gebo.core.parent</artifactId>
		<version>1.0.2.1</version>
	</parent>
	<artifactId>gebo.acl.mongo</artifactId>

	<!--
		The IAclAliasesDao of a service that OWNS the ACL store: it reads and writes
		Mongo directly. One half of a pair:

		    owns the ACL store  ->  gebo.acl.mongo                  (heimdall, monolith)
		    does not own it     ->  gebo.microservices.acl.client   (every other service)

		A service depends on exactly one, so which it uses is decided by what it
		PACKAGES. It is a separate module - and NOT part of gebo.knowledgebase.repositories,
		where it used to live - precisely because that module is on every service's
		classpath: a Mongo DAO shipped inside it would be present everywhere, would
		always win the @ConditionalOnMissingBean race, and the REST client could never
		activate. That is the trap gebo.secrets.impl and MongoSecurityDirectory both
		fell into.

		Allocation lives here and only here. addAcl() draws alias integers from a Mongo
		SEQUENCE, and onApplicationEvent() bootstraps the EVERYONE presets at startup -
		both writes. Two services allocating from one sequence would collide, which is
		why a non-owner never holds this module.
	-->
	<dependencies>
		<!-- The ACL contract this implements. -->
		<dependency>
			<groupId>ai.gebo.core</groupId>
			<artifactId>gebo.acl.services</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- IGMongoSequenceService: allocates the alias integers. -->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.persistence</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-mongodb</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
		</dependency>
	</dependencies>
</project>
