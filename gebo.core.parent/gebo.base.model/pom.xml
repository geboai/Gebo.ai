<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.core</groupId>
		<artifactId>gebo.core.parent</artifactId>
		<version>1.0.2.3-SNAPSHOT</version>
	</parent>
	<artifactId>gebo.base.model</artifactId>
	<dependencies>
		<!-- The ACL contract (ai.gebo.acl), extracted from this module into its own.
		     Depended on here so every module that already had gebo.base.model keeps
		     seeing ai.gebo.acl exactly as before - the package name did not change, so
		     not one import had to be rewritten. -->
		<dependency>
			<groupId>ai.gebo.core</groupId>
			<artifactId>gebo.acl.services</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.data</groupId>
			<artifactId>spring-data-mongodb</artifactId>
		</dependency>
		<!-- https://mvnrepository.com/artifact/com.fasterxml.jackson.core/jackson-core -->
		<dependency>
			<groupId>tools.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<scope>provided</scope>
		</dependency>
	</dependencies>
</project>