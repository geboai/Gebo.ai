<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.microservices.architecture</groupId>
		<artifactId>gebo.microservices.architecture.parent</artifactId>
		<version>1.0.2.0-SNAPSHOT</version>
	</parent>
	<artifactId>gebo.microservices.security.client</artifactId>

	<!--
		The security client-proxy for every microservice that is NOT heimdall.

		It is deliberately small: a RestSecurityDirectory, and nothing else. The
		authorization services (GSecurityServiceImpl, AclGrantedAccessorServiceImpl)
		are NOT reimplemented here - they ship unchanged from gebo.architecture.security
		and keep running their algorithm locally, over the caller's own objects and a
		locally replicated IAclAliasesDao. Only the DIRECTORY (who the users are, their
		groups, password checks) is remote.

		That is what makes this possible at all: 9 of IGSecurityService's 16 methods
		take the caller's own entity graphs, so a REST mirror of it could never have
		been written. Reimplementing the ACL rules here instead would have left two
		copies of the logic that decides who may read what.

		Activated by ai.gebo.security.directory=remote; heimdall and the monolith keep
		the local MongoSecurityDirectory.
	-->
	<dependencies>
		<!-- IGSecurityDirectory (the interface this module implements) + the user/group
		     model + the authorization services that consume the directory. -->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.security</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- GeboMicroserviceUrlResolver: resolves heimdall's base url from the topology. -->
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.topology</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- The caller-token propagator, shared with every cluster-internal client. -->
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.cluster.commons</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- WebClient. spring-webflux (not the starter) so dropping this on a servlet
		     service does not pull a reactive web server in with it. -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-webflux</artifactId>
		</dependency>
		<dependency>
			<groupId>io.projectreactor.netty</groupId>
			<artifactId>reactor-netty-http</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-autoconfigure</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
