<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.microservices.architecture</groupId>
		<artifactId>gebo.microservices.architecture.parent</artifactId>
		<version>1.0.6.0-SNAPSHOT</version>
	</parent>
	<artifactId>gebo.architecture.messages.rabbitmq</artifactId>
	<dependencies>
		<!-- Gebo in-memory messaging system, broker and external-bridge SPIs -->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.application.messaging</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- Shared microservices topology: the external emitters/receivers of
		     remote systems are deduced from it (every microservice that is not
		     the local one). -->
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.topology</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- RabbitMQ support (spring-rabbit): ConnectionFactory, RabbitTemplate, RabbitAdmin,
		     listener containers. Spring Boot 4.2 renamed its RabbitMQ starter to
		     spring-boot-starter-rabbitmq: spring-boot-starter-amqp is the generic AMQP 1.0
		     client starter since then, and carries none of these classes. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-rabbitmq</artifactId>
		</dependency>
		<!-- Jackson 3 (tools.jackson) is only 'provided' in gebo.base.model, so it is
		     not transitive here: declare it explicitly for the envelope codec -->
		<dependency>
			<groupId>tools.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
	</dependencies>
</project>
