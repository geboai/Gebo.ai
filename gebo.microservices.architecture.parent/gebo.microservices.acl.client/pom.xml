<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.microservices.architecture</groupId>
		<artifactId>gebo.microservices.architecture.parent</artifactId>
		<version>1.0.2.1</version>
	</parent>
	<artifactId>gebo.microservices.acl.client</artifactId>

	<!--
		The IAclAliasesDao of every microservice that does NOT own the ACL store: a
		REST client onto the owner, with a local TTL cache.

		The cache is what makes a replicated ACL map unnecessary. Alias data is small,
		read on every authorization decision and written almost never, so each service
		caching the entries it actually asks about beats every service maintaining a
		full replica. The price is bounded staleness (default 60s) for a change made
		elsewhere; a write made THROUGH this client invalidates its own cache at once.

		The authorization DECISION never crosses the network either way: AclAccessCheck
		runs locally, over the caller's own objects. Only the alias data is remote.

		A service depends on this OR on gebo.acl.mongo, never both.
	-->
	<dependencies>
		<dependency>
			<groupId>ai.gebo.core</groupId>
			<artifactId>gebo.acl.services</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.topology</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.cluster.commons</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-webflux</artifactId>
		</dependency>
		<dependency>
			<groupId>io.projectreactor.netty</groupId>
			<artifactId>reactor-netty-http</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-autoconfigure</artifactId>
		</dependency>
	</dependencies>
</project>
