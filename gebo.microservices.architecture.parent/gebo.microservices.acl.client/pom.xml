<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.microservices.architecture</groupId>
		<artifactId>gebo.microservices.architecture.parent</artifactId>
		<version>1.0.2.2</version>
	</parent>
	<artifactId>gebo.microservices.acl.client</artifactId>

	<properties>
		<spring-cloud.version>2025.1.2</spring-cloud.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!--
		The IAclAliasesDao of every microservice that does NOT own the ACL store: a
		REST client onto the owner, with a local TTL cache.

		The cache is what makes a replicated ACL map unnecessary. Alias data is small,
		read on every authorization decision and written almost never, so each service
		caching the entries it actually asks about beats every service maintaining a
		full replica. The price is bounded staleness (default 60s) for a change made
		elsewhere; a write made THROUGH this client invalidates its own cache at once.

		The authorization DECISION never crosses the network either way: AclAccessCheck
		runs locally, over the caller's own objects. Only the alias data is remote.

		A service depends on this OR on gebo.acl.mongo, never both.
	-->
	<dependencies>
		<dependency>
			<groupId>ai.gebo.core</groupId>
			<artifactId>gebo.acl.services</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.topology</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.cluster.commons</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- The @LoadBalanced WebClient.Builder's actual filter function: resolves the
		     topology's discovery service-id (e.g. heimdall-gebo-ai) to a live instance
		     via Eureka instead of a literal (and non-existent) DNS lookup. Declared
		     directly rather than relied on transitively, so every consumer of this
		     module gets it regardless of what else is on its classpath. -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-loadbalancer</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-webflux</artifactId>
		</dependency>
		<dependency>
			<groupId>io.projectreactor.netty</groupId>
			<artifactId>reactor-netty-http</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-autoconfigure</artifactId>
		</dependency>
	</dependencies>
</project>
