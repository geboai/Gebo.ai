<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.microservices.architecture</groupId>
		<artifactId>gebo.microservices.architecture.parent</artifactId>
		<version>1.0.2.4-SNAPSHOT</version>
	</parent>
	<artifactId>gebo.microservices.models.replication.cluster</artifactId>

	<!--
	  Initialization structure that lets a microservice join the LLM
	  models-replication Hazelcast cache. It contributes the
	  IGModelsReplicationClusterTopologyProvider bean (whose presence starts the
	  cache) by reading the participating microservice ids from application.yml
	  (gebo.models.replication.participants) and resolving them against the shared
	  GeboMicroservicesTopology. A service auto-participates only when its own
	  spring.application.name is among the configured participants.
	-->
	<dependencies>
		<!-- DiscoveryClient: seeds the Hazelcast member list from the LIVE registry
		     rather than from DNS-derived hostnames, so replicas and dynamic addresses
		     are seen. Optional at runtime - a deployment without discovery falls back
		     to the name-based provider. -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-commons</artifactId>
		</dependency>
		<!-- Shared microservices topology: source of truth for the participating
		     microservice ids (and self-identification of the running service). -->
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.topology</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- LLMs abstraction layer: brings the models-replication cluster
		     synchronizer and (transitively) gebo.architecture.hazelcast, which
		     defines IGModelsReplicationClusterTopologyProvider and consumes it. -->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.llms.abstraction.layer</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- Spring Boot auto-configuration + @ConfigurationProperties binding. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-autoconfigure</artifactId>
		</dependency>
	</dependencies>
	<properties>
		<spring-cloud.version>2025.1.2</spring-cloud.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
