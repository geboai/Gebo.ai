<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.microservices.architecture</groupId>
		<artifactId>gebo.microservices.architecture.parent</artifactId>
		<version>1.0.2.0-SNAPSHOT</version>
	</parent>
	<artifactId>gebo.microservices.llms.starter</artifactId>

	<!--
	  Aggregator starter for an LLMs-hosting microservice. Pulling this single
	  dependency gives a service the full stack to run the LLM abstraction layer
	  in the microservices architecture with cross-node models replication:

	    - gebo.architecture.llms.abstraction.layer : the LLM runtime model DAOs /
	      controllers + the models-replication cluster synchronizer.
	    - gebo.architecture.environment.microservices : declares the MICROSERVICES
	      GeboApplicationArchitecture bean.
	    - gebo.architecture.messages.rabbitmq : the external RabbitMQ messaging
	      bridge (inbound/outbound) wired from the shared topology.
	    - gebo.microservices.models.replication.cluster : auto-registers the
	      IGModelsReplicationClusterTopologyProvider (from the shared participant
	      set) so participating services start the Hazelcast models cache.
	    - gebo.microservices.topology : the shared microservices topology.
	    - gebo.ragsystem.vectorstores : the RAG vector-store integrations.
	-->
	<dependencies>
		<!--
			The cluster clients every non-heimdall service needs. They live here, in the
			starter, rather than in each app's pom: a service built on this starter is by
			definition NOT the security service, so it always resolves secrets and the
			security directory remotely.

			Deliberately NOT in gebo.microservices.starter - heimdall is built on that one,
			and giving heimdall these clients would put both a local and a remote
			implementation on one classpath.
		-->
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.secrets.client</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.security.client</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.acl.client</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.starter</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.llms.abstraction.layer</artifactId>
			<version>${project.version}</version>
		</dependency>


		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.microservices.models.replication.cluster</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>ai.gebo.ragsystem</groupId>
			<artifactId>gebo.ragsystem.vectorstores</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!--
		  Remote documents-cache client: implements IDocumentsCacheService /
		  IDocumentsChunkService (declared in gebo.architecture.documents.cache) by
		  calling the chunker microservice's controllers. An LLM service (brain, ...)
		  does not host the documents-cache implementation, so this supplies those
		  beans; the beans are @ConditionalOnMissingBean, so a service that already
		  owns the local implementation is unaffected. Configure the target with
		  ai.gebo.documents.cache.client.base-url / api-key.
		-->
		<dependency>
			<groupId>ai.gebo.microservices.architecture</groupId>
			<artifactId>gebo.architecture.documents.cache.microservice.client</artifactId>
			<version>${project.version}</version>
		</dependency>
	</dependencies>
</project>
