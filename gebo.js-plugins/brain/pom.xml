<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo</groupId>
		<artifactId>gebo.js-plugins</artifactId>
		<version>1.0.2.4</version>
	</parent>
	<artifactId>gebo.js-plugins.brain</artifactId>
	<packaging>pom</packaging>

	<properties>
		<swagger.file>http://localhost:13001/brain/v3/api-docs</swagger.file>
		<generated-sources-path>
			${project.basedir}/brain-ai-js-client</generated-sources-path>
	</properties>

	<profiles>
		<profile>
			<id>generate-rest-api</id>
			<build>
				<plugins>
					<plugin>
						<groupId>io.swagger.codegen.v3</groupId>
						<artifactId>swagger-codegen-maven-plugin</artifactId>
						<version>3.0.59</version>
						<configuration>
							<inputSpec>${swagger.file}</inputSpec>
							<configOptions></configOptions>
							<output>${generated-sources-path}</output>
						</configuration>
						<executions>
							<execution>
								<id>generate-swagger-js</id>
								<phase>generate-sources</phase>
								<goals>
									<goal>generate</goal>
								</goals>
								<configuration>
									<language>javascript</language>
									<modelPackage>model</modelPackage>
									<apiPackage>api</apiPackage>
									<additionalProperties>
										projectName=gebo.brain.client.js,moduleName=BrainClient,usePromises=true</additionalProperties>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
