<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.architecture</groupId>
		<artifactId>gebo.architecture.parent</artifactId>
		<version>1.0.3.0-SNAPSHOT</version>
	</parent>
	<artifactId>gebo.architecture.a2a-server</artifactId>

	<dependencies>
		<!-- Official A2A Java SDK: wire-spec types ONLY (Gson POJOs — AgentCard,
		     Message/Part, Task/TaskStatus, JSON-RPC envelopes). The SDK's server-common
		     is NOT used (it depends on quarkus-arc + CDI); the a2a-server serves the
		     Agent Card and the JSON-RPC + SSE endpoint over Spring MVC RouterFunctions
		     itself, mirroring the mcp-server hot-reload registry. Version pinned via the
		     a2a.sdk.version property (the SDK BOM is deliberately NOT imported — it
		     manages junit/mockito at test scope and would leak into the whole reactor). -->
		<dependency>
			<groupId>org.a2aproject.sdk</groupId>
			<artifactId>a2a-java-sdk-jsonrpc-common</artifactId>
			<version>${a2a.sdk.version}</version>
		</dependency>

		<!-- Spring MVC functional endpoints (RouterFunction) for the served A2A
		     endpoints, plus the platform persistence/security/agents runtime. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>ai.gebo.core</groupId>
			<artifactId>gebo.base.model</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.persistence</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.ai</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.security</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.secrets.services</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- Agents runtime: run an exported network via IGAgentsNetworkServiceFactory
		     -> executeNetwork, and resolve agent/network configs. The standard module
		     provides the concrete chat network factory used by the default network. -->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.agents.abstraction.layer</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.agents.standard</artifactId>
			<version>${project.version}</version>
		</dependency>
	</dependencies>
</project>
