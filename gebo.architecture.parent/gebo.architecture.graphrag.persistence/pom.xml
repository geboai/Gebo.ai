<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.architecture</groupId>
		<artifactId>gebo.architecture.parent</artifactId>
		<version>1.0.3.0-SNAPSHOT</version>
	</parent>
	<artifactId>gebo.architecture.graphrag.persistence</artifactId>
	<dependencies>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.graphrag.extraction</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!--
		  Gebo's neo4j module, not just the spring-data-neo4j library below. This
		  module's repositories extend Neo4jRepository, so they only become beans if
		  a Neo4j repository scanner registers them - and GeboNeojConfig is where
		  that scanner (@EnableNeo4jRepositories) and the cypher dialect live, both
		  gated on ai.gebo.neo4j.enabled. Without this edge a deployable could pull
		  in graphrag.persistence, switch the flag on, get the graph SERVICES and
		  then die at startup because the repositories they inject were never
		  registered - which is exactly what happened to graphicator.
		-->
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.neo4j</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- https://mvnrepository.com/artifact/org.springframework.data/spring-data-neo4j -->
		<dependency>
			<groupId>org.springframework.data</groupId>
			<artifactId>spring-data-neo4j</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		
	</dependencies>
</project>
