<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.architecture</groupId>
		<artifactId>gebo.architecture.parent</artifactId>
		<version>1.0.2.0-SNAPSHOT</version>
	</parent>
	<artifactId>gebo.architecture.workflows-concentrator</artifactId>

	<!--
	  The user-messages-concentrator-component, externalized out of gebo.core
	  (where it lived as GCoreUserMessagesReceiverFactory, hosted on core-module)
	  into its own deployable, hosted on its own module: JOBS_MASTER
	  ("jobs-master-module", see GStandardModulesConstraints). Concentrates the
	  per-item GContentsProcessingStatusUpdatePayload/GUserMessagePayload status
	  updates every content/RAG processing pipeline sends it, and once a
	  workflow's inputs are all accounted for, relays a ComputeWorkflowEndPayload
	  onward to core-module's end-of-workflow-compute-service (which stays put -
	  only the concentrator moved).

	  gebo.core is a dependency, not a coupling to undo: end-of-workflow-compute-
	  service (GComputeEndOfWorkflowReceiverFactory) and the payload it accepts
	  (ComputeWorkflowEndPayload) still live there, and this module needs both to
	  perform the same relay GCoreUserMessagesReceiverFactory always has -
	  mirroring how gebo.architecture.chat.abstraction.layer already references
	  SessionShrinkMessagesReceiver.SESSION_SHRINKER (a core-module component id)
	  the same cross-module way.
	-->
	<dependencies>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.application.messaging</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.patterns</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.core</groupId>
			<artifactId>gebo.core</artifactId>
			<version>${project.version}</version>
		</dependency>
	</dependencies>
</project>
