<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.systems</groupId>
		<artifactId>gebo.systems.parent</artifactId>
		<version>1.0.4.0-SNAPSHOT</version>
	</parent>
	<artifactId>gebo.sharepoint.handler</artifactId>
	<dependencies>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.contentsystems.abstraction.layer</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.systems</groupId>
			<artifactId>gebo.sharepoint.search.api</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.core</groupId>
			<artifactId>gebo.knowledgebase.model</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.persistence</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- 
		<dependency>
			<groupId>ai.gebo.integrations.clients</groupId>
			<artifactId>gebo.microsoft.sharepoint.client</artifactId>
			<version>${project.version}</version>
		</dependency> -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>

		</dependency>
		<!--
		https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-devtools -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>

		</dependency>
		<!-- 6.62.0 resolved microsoft-graph-core 3.6.5, which asks for
		     microsoft-kiota-abstractions 1.8.10 while the six sibling kiota artifacts
		     arrived at 1.9.0 - a set that is meant to move together. 1.8.10 is affected
		     by CVE-2026-44503 (RedirectHandler strips only Authorization on a cross-host
		     redirect, leaking Cookie and Proxy-Authorization); 1.9.1 is the fix. 6.69.0
		     brings graph-core 3.6.6 and the whole kiota set at 1.9.2. There is no kiota
		     BOM published, so bumping the aggregator beats pinning seven artifacts.
		     microsoft-graph-beta was declared here but never used: it carries the
		     com.microsoft.graph.beta.* namespace, which no source file in the reactor
		     imports, and it was the second path to the old kiota - as well as 102 MB of
		     the assembled image. Re-add it if a beta-only API is ever needed. -->
		<dependency>
			<groupId>com.microsoft.graph</groupId>
			<artifactId>microsoft-graph</artifactId>
			<version>6.69.0</version>
		</dependency>
		<dependency>
			<groupId>com.azure</groupId>
			<artifactId>azure-identity</artifactId>
			<version>1.18.2</version>
		</dependency>
		<!--
			The <content handler>.systems declarations are bound into a @Validated
			@ConfigurationProperties bean, so the declared systems are checked against
			their model's own constraints at startup. That needs a bean validation
			provider on the classpath, not merely the jakarta.validation API: it does
			arrive transitively today, but a silently skipped validation is exactly the
			failure this dependency exists to prevent.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!--
			Test-only: ai.gebo.sharepoint.systems is bound through the same
			YamlPropertySourceLoader + Binder pair the startup uses, and the resulting
			DAO exercised against a stand-in for the Mongo source.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>