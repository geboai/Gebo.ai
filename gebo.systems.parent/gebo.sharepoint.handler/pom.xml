		<dependency>
			<groupId>com.azure</groupId>
			<artifactId>azure-identity</artifactId>
			<version>1.18.2</version>
		</dependency>
		<!--
			The <content handler>.systems declarations are bound into a @Validated
			@ConfigurationProperties bean, so the declared systems are checked against
			their model's own constraints at startup. That needs a bean validation
			provider on the classpath, not merely the jakarta.validation API: it does
			arrive transitively today, but a silently skipped validation is exactly the
			failure this dependency exists to prevent.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!--
			Test-only: ai.gebo.sharepoint.systems is bound through the same
			YamlPropertySourceLoader + Binder pair the startup uses, and the resulting
			DAO exercised against a stand-in for the Mongo source.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>