<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.systems</groupId>
		<artifactId>gebo.systems.parent</artifactId>
		<version>1.0.7.0-SNAPSHOT</version>
	</parent>
	<artifactId>gebo.zammad.handler</artifactId>
	<description>Zammad content handler: the tickets of Zammad groups (with every article, internal notes included, and their attachments) and the knowledge base answers (with their attachments) as knowledge base data sources, and the Zammad tickets and knowledge base search service.</description>
	<dependencies>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.contentsystems.abstraction.layer</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.ai</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.integrations.clients</groupId>
			<artifactId>gebo.zammad.client</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ai.gebo.systems</groupId>
			<artifactId>gebo.zammad.search.api</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- cleans the html bodies of tickets and answers before they are stored -->
		<dependency>
			<groupId>org.jsoup</groupId>
			<artifactId>jsoup</artifactId>
		</dependency>
		<!--
			The <content handler>.systems declarations are bound into a @Validated
			@ConfigurationProperties bean, so the declared systems are checked against
			their model's own constraints at startup. That needs a bean validation
			provider on the classpath, not merely the jakarta.validation API: it does
			arrive transitively today, but a silently skipped validation is exactly the
			failure this dependency exists to prevent.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
