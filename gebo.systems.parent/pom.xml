<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo</groupId>
		<artifactId>ai.gebo.parent</artifactId>
		<version>1.0.2.4-SNAPSHOT</version>
	</parent>
	<groupId>ai.gebo.systems</groupId>
	<artifactId>gebo.systems.parent</artifactId>
	<packaging>pom</packaging>
	<!--
	  No global <dependencies> here. gebo.architecture.contentsystems.abstraction.layer
	  used to be declared globally and inherited by every child, which silently forced
	  it onto the web-search tools (bing/google) and the lightweight *.search.api DTO
	  modules that do not use it - and, through them, onto brain. It is now declared
	  explicitly by each real content-handler module that actually needs it.
	-->

	<modules>
		<module>gebo.git.content.handler</module>
		<module>gebo.contentsystems.starter</module>
		<module>gebo.filesystem.content.handler</module>
		<module>gebo.uploads.content.handler</module>
		<module>gebo.googlesearch.handler</module>
		<module>gebo.tavilysearch.handler</module>
		<module>gebo.bravesearch.handler</module>
		<module>gebo.searxngsearch.handler</module>
		<module>gebo.sharepoint.search.api</module>
		<module>gebo.sharepoint.handler</module>
		<module>gebo.atlassian.confluence.search.api</module>
		<module>gebo.atlassian.confluence.handler</module>
		<module>gebo.googledrive.search.api</module>
		<module>gebo.googleworkspace.handlers</module>
		<module>gebo.contentsystem.tests.services</module>
		<module>gebo.userspace.handler</module>


		<module>gebo.atlassian.jira.search.api</module>
		<module>gebo.atlassian.jira.handler</module>
		<module>gebo.integration.content.handler</module>
		<module>gebo.bingsearch.handler</module>
		<module>gebo.mcp-client.content.handler</module>
		<module>gebo.aws-s3.content.handler</module>
		<module>gebo.webdav-cms.handler</module>
	</modules>
</project>