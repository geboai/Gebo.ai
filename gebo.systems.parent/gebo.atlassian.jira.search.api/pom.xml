<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.gebo.systems</groupId>
		<artifactId>gebo.systems.parent</artifactId>
		<version>1.0.2.3-SNAPSHOT</version>
	</parent>
	<artifactId>gebo.atlassian.jira.search.api</artifactId>
	<!--
	  Lightweight shared search DTOs for Jira: the native search filter closure
	  (JiraIssuesSearchFilter et al.) and the results extraction data type
	  (JiraResultsExtractionData). Extracted out of gebo.atlassian.jira.handler so
	  both the handler (server side) and the topology-aware search REST client on
	  brain can share them without brain pulling the heavy Atlassian client SDK.
	-->
	<dependencies>
		<dependency>
			<groupId>ai.gebo.architecture</groupId>
			<artifactId>gebo.architecture.search.abstraction.layer</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-annotations</artifactId>
		</dependency>
	</dependencies>
</project>
