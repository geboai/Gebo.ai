{
  "name": "gebo-ai-ui",
  "version": "1.0.3.0-SNAPSHOT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --no-hmr",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build-prod": "ng build  --configuration production  --base-href / --aot  --output-hashing=all --delete-output-path ",
    "build-libs": "ng build gebo-ai-rest-api && ng build gebo-ai-reusable-ui && ng build gebo-ai-chat-ui && ng build gebo-ai-admin-ui",
    "pack-libs": "node -e \"require('fs').mkdirSync('../ui-exports', {recursive:true})\" && npm pack ./dist/gebo-ai-rest-api --pack-destination ../ui-exports && npm pack ./dist/gebo-ai-reusable-ui --pack-destination ../ui-exports && npm pack ./dist/gebo-ai-chat-ui --pack-destination ../ui-exports && npm pack ./dist/gebo-ai-admin-ui --pack-destination ../ui-exports",
    "export-libs": "npm run build-libs && npm run pack-libs",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.18",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/forms": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@angular/platform-browser-dynamic": "^21.2.18",
    "@angular/router": "^21.2.18",
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@primeng/themes": "^21.0.4",
    "angular-oauth2-oidc": "^21.0.3",
    "chart.js": "^4.4.4",
    "clipboard": "^2.0.11",
    "emoji-toolkit": "^9.0.1",
    "katex": "^0.16.22",
    "marked": "^18.0.0",
    "mermaid": "^11.6.0",
    "monaco-editor": "^0.55.1",
    "ng-diagram": "^1.2.4",
    "ngx-cookie-service": "^21.3.1",
    "ngx-extended-pdf-viewer": "^28.1.0",
    "ngx-markdown": "^21.3.0",
    "ngx-monaco-editor-v2": "^21.1.4",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.9",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^11.1.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.18",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^21.2.5",
    "typescript": "~5.9.0"
  }
}
