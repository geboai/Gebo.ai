{
  "name": "gebo-ai-ui",
  "version": "1.0.7.0-SNAPSHOT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --no-hmr",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build-prod": "ng build  --configuration production  --base-href / --aot  --output-hashing=all --delete-output-path ",
    "build-libs": "ng build gebo-ai-rest-api && ng build gebo-ai-reusable-ui && ng build gebo-ai-chat-ui && ng build gebo-ai-admin-ui",
    "pack-libs": "node -e \"require('fs').mkdirSync('../ui-exports', {recursive:true})\" && npm pack ./dist/gebo-ai-rest-api --pack-destination ../ui-exports && npm pack ./dist/gebo-ai-reusable-ui --pack-destination ../ui-exports && npm pack ./dist/gebo-ai-chat-ui --pack-destination ../ui-exports && npm pack ./dist/gebo-ai-admin-ui --pack-destination ../ui-exports",
    "export-libs": "npm run build-libs && npm run pack-libs",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.6",
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@openng/icons": "^1.0.0",
    "@openng/optimus-ui": "^2.0.2",
    "@openng/optimus-ui-themes": "^2.0.2",
    "angular-oauth2-oidc": "^22.0.2",
    "chart.js": "^4.4.4",
    "clipboard": "^2.0.11",
    "emoji-toolkit": "^9.0.1",
    "katex": "^0.16.22",
    "marked": "^18.0.0",
    "mermaid": "^11.17.2",
    "monaco-editor": "^0.57.0",
    "ng-diagram": "^1.2.4",
    "ngx-cookie-service": "^22.2.0",
    "ngx-extended-pdf-viewer": "^31.0.1",
    "ngx-markdown": "^22.1.1",
    "ngx-monaco-editor-v2": "^22.0.5",
    "primeflex": "^4.0.0",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^11.1.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@types/jasmine": "~5.1.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^22.2.6",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "ngx-monaco-editor-v2": {
      "monaco-editor": "$monaco-editor"
    },
    "dompurify": "^3.4.17"
  }
}
